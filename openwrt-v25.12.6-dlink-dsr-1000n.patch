++/*
++ * CTR cross-check against aes-generic: random key, counter close to a 64-bit
++ * carry, data split at odd offsets including partial blocks.
++ */
++static int octeon_aes_ctr_check(void)
++{
++	static const unsigned int lens[] = { 1, 15, 16, 17, 63, 200, 1000 };
++	struct octeon_cop2_state state;
++	struct crypto_cipher *gen;
++	struct octeon_aes_ctx ctx;
++	u8 key[32], iv0[16], iv[16], ctr[16], ks[16];
++	unsigned long flags;
++	u8 *src, *hw, *ref;
++	int i, j, bad = 0, kl;
++
++	gen = crypto_alloc_cipher("aes-generic", 0, 0);
++	if (IS_ERR(gen))
++		return PTR_ERR(gen);
++	src = kmalloc(3 * 1024, GFP_KERNEL);
++	if (!src) {
++		crypto_free_cipher(gen);
++		return -ENOMEM;
++	}
++	hw = src + 1024;
++	ref = hw + 1024;
++	get_random_bytes(src, 1024);
++
++	for (kl = 16; kl <= 32 && !bad; kl += 8) {
++		get_random_bytes(key, sizeof(key));
++		get_random_bytes(iv0, sizeof(iv0));
++		memset(iv0 + 8, 0xff, 7);	/* low 64 bits about to carry */
++		octeon_aes_expand(&ctx, key, kl);
++		crypto_cipher_setkey(gen, key, kl);
++		for (i = 0; i < ARRAY_SIZE(lens) && !bad; i++) {
++			unsigned int len = lens[i], half = len / 2 & ~15u;
++
++			/* reference: plain CTR with aes-generic */
++			memcpy(ctr, iv0, 16);
++			for (j = 0; j < len; j += 16) {
++				crypto_cipher_encrypt_one(gen, ks, ctr);
++				crypto_xor_cpy(ref + j, src + j, ks,
++					       min_t(unsigned int, 16, len - j));
++				crypto_inc(ctr, 16);
++			}
++			/* hardware, in two calls to check counter hand-over */
++			memcpy(iv, iv0, 16);
++			flags = octeon_crypto_enable(&state);
++			octeon_aes_ctr_bytes(&ctx, hw, src, half, iv);
++			octeon_aes_ctr_bytes(&ctx, hw + half, src + half,
++					     len - half, iv);
++			octeon_crypto_disable(&state, flags);
++			if (memcmp(hw, ref, len) || memcmp(iv, ctr, 16)) {
++				pr_err("octeon-aes: CTR check failed (AES-%d, %u bytes)\n",
++				       kl * 8, len);
++				bad = 1;
++			}
++		}
++	}
++	memzero_explicit(&ctx, sizeof(ctx));
++	memzero_explicit(key, sizeof(key));
++	kfree(src);
++	crypto_free_cipher(gen);
++	return bad ? -EIO : 0;
++}
