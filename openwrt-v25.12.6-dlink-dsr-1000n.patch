++static void octeon_aes_bench(void)
++{
++	struct octeon_cop2_state state;
++	struct crypto_cipher *gen;
++	struct octeon_aes_ctx ctx;
++	unsigned long flags;
++	u64 t, ns_hw, ns_cbc, ns_gen;
++	u8 *buf, iv[16] = { 0 };
++	unsigned int i, r;
++
++	buf = kzalloc(BENCH_LEN, GFP_KERNEL);
++	if (!buf)
++		return;
++	octeon_aes_expand(&ctx, kat_key, 16);
++
++	t = ktime_get_ns();
++	for (r = 0; r < BENCH_ROUNDS; r++) {
++		flags = octeon_crypto_enable(&state);
++		octeon_aes_ecb_blocks(&ctx, buf, buf, BENCH_LEN / 16, true);
++		octeon_crypto_disable(&state, flags);
++	}
++	ns_hw = ktime_get_ns() - t;
++
++	t = ktime_get_ns();
++	for (r = 0; r < BENCH_ROUNDS; r++) {
++		flags = octeon_crypto_enable(&state);
++		octeon_aes_cbc_blocks(&ctx, buf, buf, BENCH_LEN / 16, iv, true);
++		octeon_crypto_disable(&state, flags);
++	}
++	ns_cbc = ktime_get_ns() - t;
++
++	ns_gen = 0;
++	gen = crypto_alloc_cipher("aes-generic", 0, 0);
++	if (!IS_ERR(gen)) {
++		crypto_cipher_setkey(gen, kat_key, 16);
++		t = ktime_get_ns();
++		for (r = 0; r < BENCH_ROUNDS; r++)
++			for (i = 0; i < BENCH_LEN; i += 16)
++				crypto_cipher_encrypt_one(gen, buf + i, buf + i);
++		ns_gen = ktime_get_ns() - t;
++		crypto_free_cipher(gen);
++	}
++
++#define MBPS(ns) ((ns) ? (u32)div64_u64((u64)BENCH_LEN * BENCH_ROUNDS * 1000, (ns)) : 0)
++	pr_info("octeon-aes: AES-128 ECB %u MB/s, CBC %u MB/s (hardware); aes-generic %u MB/s\n",
++		MBPS(ns_hw), MBPS(ns_cbc), MBPS(ns_gen));
++	kfree(buf);
++	memzero_explicit(&ctx, sizeof(ctx));
++}
