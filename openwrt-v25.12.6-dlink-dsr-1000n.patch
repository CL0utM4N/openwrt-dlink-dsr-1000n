++	0x21, 0xd5, 0x14, 0xb2, 0x54, 0x66, 0x93, 0x1c,
++	0x7d, 0x8f, 0x6a, 0x5a, 0xac, 0x84, 0xaa, 0x05,
++	0x1b, 0xa3, 0x0b, 0x39, 0x6a, 0x0a, 0xac, 0x97,
++	0x3d, 0x58, 0xe0, 0x91 };
++static const u8 tc4_tag[16] = {
++	0x5b, 0xc9, 0x4f, 0xbc, 0x32, 0x21, 0xa5, 0xdb,
++	0x94, 0xfa, 0xe9, 0x5a, 0xe7, 0x12, 0x1a, 0x47 };
++
++static int octeon_gcm_kat(void)
++{
++	struct octeon_gcm_ctx ctx;
++	u8 out[60], tag[16];
++	int bad = 0;
++
++	octeon_gcm_aes_setkey(&ctx, tc4_key, 16);
++	gcm_linear(&ctx, tc4_iv, tc4_aad, 20, out, tc4_pt, 60, true, tag);
++	if (memcmp(out, tc4_ct, 60) || memcmp(tag, tc4_tag, 16)) {
++		pr_err("octeon-gcm: encrypt known-answer test failed\n");
++		pr_err("octeon-gcm: tag %16phN\n", tag);
++		bad = 1;
++	}
++	memcpy(out, tc4_ct, 60);
++	gcm_linear(&ctx, tc4_iv, tc4_aad, 20, out, out, 60, false, tag);
++	if (memcmp(out, tc4_pt, 60) || memcmp(tag, tc4_tag, 16)) {
++		pr_err("octeon-gcm: decrypt known-answer test failed\n");
++		bad = 1;
++	}
++	memzero_explicit(&ctx, sizeof(ctx));
++	return bad ? -EIO : 0;
++}
++
++/* Random cross-check against gcm_base(ctr(aes-generic),ghash-generic). */
++static int octeon_gcm_check(void)
++{
++	static const unsigned int alens[] = { 0, 8, 20, 33, 300 };
++	static const unsigned int plens[] = { 0, 1, 15, 16, 17, 60, 1000 };
++	struct crypto_aead *gen;
++	struct aead_request *req = NULL;
++	struct octeon_gcm_ctx ctx;
++	struct scatterlist sg;
++	DECLARE_CRYPTO_WAIT(wait);
++	u8 key[32], iv[12], tag[16], *buf, *src, *hw;
++	int kl, i, j, bad = 0, err;
++
++	gen = crypto_alloc_aead("gcm_base(ctr(aes-generic),ghash-generic)", 0,
++				CRYPTO_ALG_ASYNC);
++	if (IS_ERR(gen))
++		return PTR_ERR(gen);
++	err = crypto_aead_setauthsize(gen, 16);
++	buf = kmalloc(3 * 1400, GFP_KERNEL);
++	req = aead_request_alloc(gen, GFP_KERNEL);
++	if (err || !buf || !req) {
++		err = err ?: -ENOMEM;
++		goto out;
++	}
++	src = buf + 1400;
++	hw = src + 1400;
++	for (kl = 16; kl <= 32 && !bad; kl += 8) {
++		for (i = 0; i < ARRAY_SIZE(alens) && !bad; i++) {
++			for (j = 0; j < ARRAY_SIZE(plens) && !bad; j++) {
++				unsigned int al = alens[i], pl = plens[j];
++
++				get_random_bytes(key, sizeof(key));
++				get_random_bytes(iv, sizeof(iv));
++				get_random_bytes(src, al + pl);
++				if ((kl + i + j) & 1)	/* counter near inc32 wrap */
++					memset(iv + 8, 0xff, 4);
++				memcpy(buf, src, al + pl);
++				err = crypto_aead_setkey(gen, key, kl);
++				if (err)
++					goto out;
++				sg_init_one(&sg, buf, al + pl + 16);
++				aead_request_set_callback(req, 0, crypto_req_done, &wait);
++				aead_request_set_crypt(req, &sg, &sg, pl, iv);
++				aead_request_set_ad(req, al);
++				err = crypto_wait_req(crypto_aead_encrypt(req), &wait);
++				if (err)
++					goto out;
++				octeon_gcm_aes_setkey(&ctx, key, kl);
++				gcm_linear(&ctx, iv, src, al, hw, src + al, pl,
++					   true, tag);
++				if (memcmp(hw, buf + al, pl) ||
++				    memcmp(tag, buf + al + pl, 16)) {
++					pr_err("octeon-gcm: mismatch vs generic (AES-%d, aad %u, len %u)\n",
++					       kl * 8, al, pl);
++					bad = 1;
++				}
++				/* and back, in place */
++				gcm_linear(&ctx, iv, src, al, hw, hw, pl, false, tag);
++				if (memcmp(hw, src + al, pl) ||
++				    memcmp(tag, buf + al + pl, 16)) {
++					pr_err("octeon-gcm: decrypt mismatch (AES-%d, aad %u, len %u)\n",
++					       kl * 8, al, pl);
++					bad = 1;
++				}
++			}
++		}
++	}
++	err = bad ? -EIO : 0;
++out:
++	memzero_explicit(&ctx, sizeof(ctx));
++	memzero_explicit(key, sizeof(key));
++	aead_request_free(req);
++	kfree(buf);
++	crypto_free_aead(gen);
++	return err;
++}
++
++static int __init octeon_gcm_mod_init(void)
++{
++	int err;
++
++	if (!octeon_has_crypto())
++		return -ENOTSUPP;
++	err = octeon_gcm_kat();
++	if (!err)
++		err = octeon_gcm_check();
++	if (err)
++		return err;
++	pr_info("octeon-gcm: self-tests passed (GCM test case 4, cross-check vs generic)\n");
++	return crypto_register_aeads(octeon_gcm_algs, ARRAY_SIZE(octeon_gcm_algs));
++}
++
++static void __exit octeon_gcm_mod_exit(void)
++{
++	crypto_unregister_aeads(octeon_gcm_algs, ARRAY_SIZE(octeon_gcm_algs));
++}
++
++module_init(octeon_gcm_mod_init);
++module_exit(octeon_gcm_mod_exit);
++
++MODULE_LICENSE("GPL");
++MODULE_DESCRIPTION("AES-GCM (one pass) using the OCTEON crypto coprocessor");
++MODULE_ALIAS_CRYPTO("gcm(aes)");
++MODULE_ALIAS_CRYPTO("gcm-aes-octeon");
++MODULE_ALIAS_CRYPTO("rfc4106(gcm(aes))");
++MODULE_ALIAS_CRYPTO("rfc4106-gcm-aes-octeon");
+diff -Nurp a/arch/mips/cavium-octeon/crypto/octeon-ghash.c b/arch/mips/cavium-octeon/crypto/octeon-ghash.c
+--- a/arch/mips/cavium-octeon/crypto/octeon-ghash.c	1970-01-01 10:00:00.000000000 +1000
++++ b/arch/mips/cavium-octeon/crypto/octeon-ghash.c	2026-11-12 10:31:06.258503059 +1100
+@@ -0,0 +1,239 @@
++// SPDX-License-Identifier: GPL-2.0
++/*
++ * GHASH (the GCM authentication hash) using the OCTEON Galois-field
++ * multiplier in the crypto coprocessor (COP2). With ctr-aes-octeon the
++ * generic gcm template then runs AES-GCM entirely on the crypto unit.
++ *
++ * COP2 register selectors as used by the Cavium OCTEON SDK (cvmx-asm.h):
++ *   0x0258-0x0259  GFM multiplier (the hash key H)
++ *   0x025a-0x025b  GFM result / input (the running hash Y)
++ *   0x025c         XOR into Y, high dword
++ *   0x425d         XOR into Y, low dword, then Y = Y * H
++ *   0x025e         GFM polynomial (0xe100 for the GCM field)
++ *
++ * Same buffering semantics as crypto/ghash-generic.c. The module compares
++ * itself against ghash-generic at load and refuses to register on mismatch.
++ */
++
++#include <crypto/ghash.h>
++#include <crypto/internal/hash.h>
++#include <linux/kernel.h>
++#include <linux/module.h>
++#include <linux/random.h>
++#include <linux/slab.h>
++#include <linux/unaligned.h>
++#include <asm/octeon/octeon.h>
++
++#include "octeon-crypto.h"
++
++#define OCT_MT(val, sel) \
++	__asm__ __volatile__("dmtc2 %[rt]," #sel : : [rt] "d" ((u64)(val)))
++#define OCT_MF(sel) ({ u64 __v; \
++	__asm__ __volatile__("dmfc2 %[rt]," #sel : [rt] "=d" (__v)); __v; })
++
++struct ghash_octeon_key {
++	u64 h[2];
++};
++
++struct ghash_octeon_desc {
++	u8 buffer[GHASH_BLOCK_SIZE];	/* running hash Y */
++	u32 bytes;			/* bytes still missing from a block */
++};
++
++static const u8 zero_block[GHASH_BLOCK_SIZE];
++
++/* Y = (Y ^ X1) * H, (Y ^ X2) * H, ... over nblocks blocks of src. */
++static void ghash_octeon_blocks(const struct ghash_octeon_key *k, u8 *y,
++				const u8 *src, unsigned int nblocks)
++{
++	struct octeon_cop2_state state;
++	unsigned long flags;
++
++	flags = octeon_crypto_enable(&state);
++	OCT_MT(0xe100, 0x025e);
++	OCT_MT(k->h[0], 0x0258);
++	OCT_MT(k->h[1], 0x0259);
++	OCT_MT(get_unaligned_be64(y), 0x025a);
++	OCT_MT(get_unaligned_be64(y + 8), 0x025b);
++	while (nblocks--) {
++		OCT_MT(get_unaligned_be64(src), 0x025c);
++		OCT_MT(get_unaligned_be64(src + 8), 0x425d);
++		src += GHASH_BLOCK_SIZE;
++	}
++	put_unaligned_be64(OCT_MF(0x025a), y);
++	put_unaligned_be64(OCT_MF(0x025b), y + 8);
++	octeon_crypto_disable(&state, flags);
++}
++
++static int ghash_octeon_setkey(struct crypto_shash *tfm, const u8 *key,
++			       unsigned int keylen)
++{
++	struct ghash_octeon_key *k = crypto_shash_ctx(tfm);
++
++	if (keylen != GHASH_BLOCK_SIZE)
++		return -EINVAL;
++	k->h[0] = get_unaligned_be64(key);
++	k->h[1] = get_unaligned_be64(key + 8);
++	return 0;
++}
++
++static int ghash_octeon_init(struct shash_desc *desc)
++{
++	struct ghash_octeon_desc *d = shash_desc_ctx(desc);
++
++	memset(d, 0, sizeof(*d));
++	return 0;
++}
++
++static void __ghash_octeon_update(const struct ghash_octeon_key *k,
++				  struct ghash_octeon_desc *d,
++				  const u8 *src, unsigned int srclen)
++{
++	u8 *dst = d->buffer;
++
++	if (d->bytes) {
++		unsigned int n = min(srclen, d->bytes);
++		u8 *pos = dst + (GHASH_BLOCK_SIZE - d->bytes);
++
++		d->bytes -= n;
++		srclen -= n;
++		while (n--)
++			*pos++ ^= *src++;
++		if (!d->bytes)
++			ghash_octeon_blocks(k, dst, zero_block, 1);
++	}
++	if (srclen >= GHASH_BLOCK_SIZE) {
++		unsigned int nblocks = srclen / GHASH_BLOCK_SIZE;
++
++		ghash_octeon_blocks(k, dst, src, nblocks);
++		src += nblocks * GHASH_BLOCK_SIZE;
++		srclen -= nblocks * GHASH_BLOCK_SIZE;
++	}
++	if (srclen) {
++		d->bytes = GHASH_BLOCK_SIZE - srclen;
++		while (srclen--)
++			*dst++ ^= *src++;
++	}
++}
++
++static void __ghash_octeon_final(const struct ghash_octeon_key *k,
++				 struct ghash_octeon_desc *d, u8 *out)
++{
++	if (d->bytes)
++		ghash_octeon_blocks(k, d->buffer, zero_block, 1);
++	memcpy(out, d->buffer, GHASH_DIGEST_SIZE);
++	memzero_explicit(d, sizeof(*d));
++}
++
++static int ghash_octeon_update(struct shash_desc *desc, const u8 *src,
++			       unsigned int srclen)
++{
++	__ghash_octeon_update(crypto_shash_ctx(desc->tfm), shash_desc_ctx(desc),
++			      src, srclen);
++	return 0;
++}
++
++static int ghash_octeon_final(struct shash_desc *desc, u8 *out)
++{
++	__ghash_octeon_final(crypto_shash_ctx(desc->tfm), shash_desc_ctx(desc),
++			     out);
++	return 0;
++}
++
++static struct shash_alg ghash_octeon_alg = {
++	.digestsize	= GHASH_DIGEST_SIZE,
++	.init		= ghash_octeon_init,
++	.update		= ghash_octeon_update,
++	.final		= ghash_octeon_final,
++	.setkey		= ghash_octeon_setkey,
++	.descsize	= sizeof(struct ghash_octeon_desc),
++	.base = {
++		.cra_name		= "ghash",
++		.cra_driver_name	= "ghash-octeon",
++		.cra_priority		= OCTEON_CR_OPCODE_PRIORITY,
++		.cra_blocksize		= GHASH_BLOCK_SIZE,
++		.cra_ctxsize		= sizeof(struct ghash_octeon_key),
++		.cra_module		= THIS_MODULE,
++	},
++};
++
++/* Cross-check against ghash-generic with odd update splits. */
++static int ghash_octeon_check(void)
++{
++	static const unsigned int splits[][3] = {
++		{ 16, 0, 0 }, { 5, 0, 0 }, { 3, 13, 16 }, { 100, 7, 200 },
++		{ 1, 1, 1 }, { 64, 64, 1 }, { 17, 31, 47 },
++	};
++	struct ghash_octeon_desc dh;
++	struct ghash_octeon_key kh;
++	struct crypto_shash *gen;
++	u8 key[16], out_g[16], out_h[16], *data;
++	int i, j, bad = 0, err;
++
++	gen = crypto_alloc_shash("ghash-generic", 0, 0);
++	if (IS_ERR(gen))
++		return PTR_ERR(gen);
++	data = kmalloc(512, GFP_KERNEL);
++	if (!data) {
++		err = -ENOMEM;
++		goto out;
++	}
++	for (i = 0; i < ARRAY_SIZE(splits) && !bad; i++) {
++		SHASH_DESC_ON_STACK(dg, gen);
++
++		get_random_bytes(key, sizeof(key));
++		get_random_bytes(data, 512);
++		crypto_shash_setkey(gen, key, 16);
++		kh.h[0] = get_unaligned_be64(key);
++		kh.h[1] = get_unaligned_be64(key + 8);
++		dg->tfm = gen;
++		crypto_shash_init(dg);
++		memset(&dh, 0, sizeof(dh));
++		for (j = 0; j < 3; j++) {
++			unsigned int off = splits[i][0] * (j > 0) + splits[i][1] * (j > 1);
++
++			crypto_shash_update(dg, data + off, splits[i][j]);
++			__ghash_octeon_update(&kh, &dh, data + off, splits[i][j]);
++		}
++		crypto_shash_final(dg, out_g);
++		__ghash_octeon_final(&kh, &dh, out_h);
++		if (memcmp(out_g, out_h, 16)) {
++			pr_err("octeon-ghash: mismatch vs ghash-generic (case %d)\n", i);
++			pr_err("octeon-ghash: generic %16phN octeon %16phN\n",
++			       out_g, out_h);
++			bad = 1;
++		}
++	}
++	err = bad ? -EIO : 0;
++	kfree(data);
++	memzero_explicit(&kh, sizeof(kh));
++out:
++	crypto_free_shash(gen);
++	return err;
++}
++
++static int __init ghash_octeon_mod_init(void)
++{
++	int err;
++
++	if (!octeon_has_crypto())
++		return -ENOTSUPP;
++	err = ghash_octeon_check();
++	if (err)
++		return err;
++	pr_info("octeon-ghash: self-test against ghash-generic passed\n");
++	return crypto_register_shash(&ghash_octeon_alg);
++}
++
++static void __exit ghash_octeon_mod_exit(void)
++{
++	crypto_unregister_shash(&ghash_octeon_alg);
++}
++
++module_init(ghash_octeon_mod_init);
++module_exit(ghash_octeon_mod_exit);
++
++MODULE_LICENSE("GPL");
++MODULE_DESCRIPTION("GHASH using the OCTEON crypto coprocessor");
++MODULE_ALIAS_CRYPTO("ghash");
++MODULE_ALIAS_CRYPTO("ghash-octeon");
