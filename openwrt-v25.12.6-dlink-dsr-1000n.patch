index 0000000..858f02d
--- /dev/null
+++ b/target/linux/octeon/patches-6.12/177-staging-octeon-fwd-ipv6-encap-sqm-wifi.patch
@@ -0,0 +1,871 @@
+From: Lachlan Green <69705346+CL0utM4N@users.noreply.github.com>
+Subject: [PATCH] staging: octeon: octeon-fwd: IPv6, VLAN/PPPoE, shaper-aware, skb transmit
+
+- IPv6 (TCP/UDP, no extension headers) next to IPv4.
+- VLAN (802.1Q/802.1ad), PPPoE and PPPoE over VLAN: headers popped on
+  receive and pushed on transmit; the output VLAN/PPP device is followed
+  down to its port with dev_fill_forward_path(), as the flowtable does.
+  Counters of the VLAN/PPP devices are kept.
+- Never bypass shaping: packets on a port with tc ingress (SQM download
+  side) take the normal path; a shaping qdisc on any output device sends
+  the packet through dev_queue_xmit() instead of straight to the PKO.
+- Outputs that are not Octeon ports (Wi-Fi, other drivers) get the
+  rewritten packet as an skb through dev_queue_xmit() (new hook result
+  CVM_OCT_RX_STOLEN), saving the second lookup in the flowtable.
+- Driver fast path: ports with tc ingress keep the normal path, so
+  nf_hook_ingress() no longer runs ahead of SQM's ingress shaping.
+diff -Nurp a/drivers/staging/octeon/ethernet-rx.c b/drivers/staging/octeon/ethernet-rx.c
+--- a/drivers/staging/octeon/ethernet-rx.c	2026-11-12 12:57:06.245311543 +1100
++++ b/drivers/staging/octeon/ethernet-rx.c	2026-11-12 12:57:28.517225847 +1100
+@@ -202,6 +202,16 @@ module_param(fastpath_misses, ulong, 044
+ static unsigned long fastpath_seen;
+ module_param(fastpath_seen, ulong, 0444);
+ 
++/* tc ingress (ingress/clsact qdisc, e.g. SQM's download shaping) on @dev */
++static inline bool cvm_oct_tc_ingress(const struct net_device *dev)
++{
++#ifdef CONFIG_NET_XGRESS
++	return rcu_access_pointer(dev->tcx_ingress);
++#else
++	return false;
++#endif
++}
++
+ /* Returns true if the skb was consumed (forwarded, delivered or freed). */
+ static bool cvm_oct_fastpath_rx(struct sk_buff *skb)
+ {
+@@ -209,6 +219,13 @@ static bool cvm_oct_fastpath_rx(struct s
+ 	struct sk_buff *nskb;
+ 	int ret;
+ 
++	/*
++	 * nf_hook_ingress() below runs before tc ingress would: a port with
++	 * ingress shaping keeps the normal path so the shaper sees everything.
++	 */
++	if (cvm_oct_tc_ingress(dev))
++		return false;
++
+ 	if (netdev_uses_dsa(dev)) {
+ 		struct dsa_port *cpu_dp = dev->dsa_ptr;
+ 		__be16 etype;
+@@ -268,6 +285,9 @@ static bool cvm_oct_fastpath_rx(struct s
+ 		if (!rcu_access_pointer(user->nf_hooks_ingress))
+ 			target = upper;
+ 	}
++	if (cvm_oct_tc_ingress(user) ||
++	    (target != user && cvm_oct_tc_ingress(target)))
++		goto slow;
+ 	if (!ether_addr_equal(eth_hdr(skb)->h_dest, upper->dev_addr))
+ 		goto slow;
+ 
+@@ -477,6 +497,8 @@ static int cvm_oct_poll(struct oct_rx_gr
+ 						cvm_oct_free_work(work);
+ 						continue;
+ 					}
++					if (r == CVM_OCT_RX_STOLEN)
++						goto rx_done;	/* skb owned by the hook */
+ 				}
+ 				skb->protocol = eth_type_trans(skb, dev);
+ 				skb->dev = dev;
+@@ -516,6 +538,7 @@ static int cvm_oct_poll(struct oct_rx_gr
+ 					   port);
+ 			dev_kfree_skb_irq(skb);
+ 		}
++rx_done:
+ 		/*
+ 		 * Check to see if the skbuff and work share the same
+ 		 * packet buffer.
+diff -Nurp a/drivers/staging/octeon/octeon-ethernet.h b/drivers/staging/octeon/octeon-ethernet.h
+--- a/drivers/staging/octeon/octeon-ethernet.h	2026-11-12 12:57:06.244960838 +1100
++++ b/drivers/staging/octeon/octeon-ethernet.h	2026-11-12 12:57:28.516768952 +1100
+@@ -94,9 +94,10 @@ int cvm_oct_free_work(void *work_queue_e
+  * Optional receive hook for a hardware-buffer forwarding engine (octeon-fwd).
+  * Called from the NAPI loop for zero-copy packets, before the stack sees them.
+  * Returns CVM_OCT_RX_PASS to continue normally, CVM_OCT_RX_SENT if the packet
+- * buffer was handed to the PKO (hardware frees it), CVM_OCT_RX_DROP to drop.
++ * buffer was handed to the PKO (hardware frees it), CVM_OCT_RX_DROP to drop,
++ * CVM_OCT_RX_STOLEN if the hook consumed the skb (e.g. dev_queue_xmit()).
+  */
+-enum { CVM_OCT_RX_PASS, CVM_OCT_RX_SENT, CVM_OCT_RX_DROP };
++enum { CVM_OCT_RX_PASS, CVM_OCT_RX_SENT, CVM_OCT_RX_DROP, CVM_OCT_RX_STOLEN };
+ typedef int (*cvm_oct_rx_hook_t)(struct net_device *dev, struct cvmx_wqe *work,
+ 				 struct sk_buff *skb);
+ int cvm_oct_set_rx_hook(cvm_oct_rx_hook_t hook);
+diff -Nurp a/drivers/staging/octeon/octeon-fwd.c b/drivers/staging/octeon/octeon-fwd.c
+--- a/drivers/staging/octeon/octeon-fwd.c	2026-11-12 12:57:06.243758389 +1100
++++ b/drivers/staging/octeon/octeon-fwd.c	2026-11-12 14:48:41.571030715 +1100
+@@ -6,23 +6,36 @@
+  *
+  * For every zero-copy packet the octeon-ethernet RX loop receives, this
+  * module looks the flow up in the netfilter flowtable registered on the
+- * ingress switch port (software flow offloading, fw4 on lower devices), and
+- * on a hit rewrites the packet in place (NAT, TTL, MACs, Broadcom egress tag)
+- * and hands the same FPA buffer to the PKO, which frees it back into the
+- * receive pool. No skb processing, no network stack, no DSA/bridge layers.
++ * ingress port (software flow offloading, fw4 on lower devices). On a hit:
+  *
+- * Flow state is the kernel's own: which connections are offloaded is still
+- * decided by netfilter, and timeouts, NAT and counters follow the flowtable's
+- * own rules (same checks as nf_flow_offload_ip_hook()). Everything else
+- * (misses, non-IPv4, options, fragments, TCP FIN/RST, MTU, non-direct
+- * transmit paths) passes through unchanged to the normal receive path.
++ *  - Octeon output port, no queueing discipline in the way: the packet is
++ *    rewritten in place (NAT, TTL/hop limit, MACs, Broadcom tag, VLAN and
++ *    PPPoE headers) and the same FPA buffer goes to the PKO, which frees it
++ *    back into the receive pool. No skb processing, stack, DSA or bridge.
++ *  - Any other output (Wi-Fi, other drivers) or a port with a shaper such as
++ *    SQM/cake: the packet is rewritten the same way and handed to
++ *    dev_queue_xmit() as an skb, so qdiscs and other drivers see it exactly
++ *    as from the flowtable's own transmit path, minus the second lookup.
++ *
++ * IPv4 and IPv6 (TCP/UDP), plain, VLAN (802.1Q/802.1ad), PPPoE and PPPoE
++ * over VLAN. Flow state is the kernel's own: which connections are offloaded
++ * is still decided by netfilter, and timeouts, NAT and counters follow the
++ * flowtable's own rules (same checks as nf_flow_offload_ip(v6)_hook()).
++ * Packets on a port with ingress shaping (tc ingress, e.g. SQM's download
++ * side) are never taken. Everything else (misses, other protocols, options,
++ * extension headers, fragments, TCP FIN/RST, MTU, IPv6 NAT, IPsec, bridge
++ * VLANs) passes through unchanged to the normal receive path.
+  */
+ 
+ #include <linux/module.h>
+ #include <linux/netdevice.h>
+ #include <linux/etherdevice.h>
+ #include <linux/if_bridge.h>
++#include <linux/if_vlan.h>
++#include <linux/if_pppox.h>
+ #include <linux/ip.h>
++#include <linux/ipv6.h>
++#include <linux/ppp_defs.h>
+ #include <linux/tcp.h>
+ #include <linux/udp.h>
+ #include <linux/netfilter.h>
+@@ -30,9 +43,12 @@
+ #include <net/arp.h>
+ #include <net/dsa.h>
+ #include <net/ip.h>
++#include <net/ip6_route.h>
++#include <net/ndisc.h>
+ #include <net/neighbour.h>
+ #include <net/route.h>
+ #include <net/checksum.h>
++#include <net/sch_generic.h>
+ #include <net/netfilter/nf_flow_table.h>
+ #include <net/netfilter/nf_conntrack_acct.h>
+ 
+@@ -44,19 +60,24 @@ MODULE_PARM_DESC(enable, "Forward offloa
+ 
+ static unsigned long hits;
+ module_param(hits, ulong, 0444);
++MODULE_PARM_DESC(hits, "Packets forwarded straight to the PKO");
++static unsigned long skb_hits;
++module_param(skb_hits, ulong, 0444);
++MODULE_PARM_DESC(skb_hits, "Packets forwarded through dev_queue_xmit (Wi-Fi, shaped ports)");
+ static unsigned long misses;
+ module_param(misses, ulong, 0444);
+ static unsigned long passed;
+ module_param(passed, ulong, 0444);
+ 
+ #define BRCM_TAG_LEN		4
+-#define BRCM_ETH_HLEN		(2 * ETH_ALEN + BRCM_TAG_LEN + 2)	/* 18 */
+ #define BRCM_OPCODE_SHIFT	5
+ #define BRCM_OPCODE_MASK	0x7
+ #define BRCM_EG_RC_RSVD		(3 << 6)
+ #define BRCM_EG_PID_MASK	0x1f
+ #define BRCM_IG_DSTMAP1_MASK	0xff
+ 
++#define FWD_ENCAP_MAX		NF_FLOW_TABLE_ENCAP_MAX	/* 2 */
++
+ /*
+  * Per-packet device resolution is cached; any netdev change flushes the
+  * caches (netdevice notifier). Entries are plain pointers read under RCU:
+@@ -68,12 +89,22 @@ struct fwd_in_ent {
+ };
+ static struct fwd_in_ent fwd_in_cache[32];
+ 
