 $(eval $(call KernelPackage,crypto-xxhash))
 
+
+
+define KernelPackage/crypto-aes-octeon
+  TITLE:=AES cipher, ECB, CBC and CTR using the OCTEON crypto unit
+  DEPENDS:=@TARGET_octeon +kmod-crypto-manager
