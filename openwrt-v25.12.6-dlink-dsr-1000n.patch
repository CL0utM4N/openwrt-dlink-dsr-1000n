+#!/bin/sh
+# Enable the Octeon forwarding accelerations at boot, and software flow
+# offloading (the fast path builds on it), on the DSR-1000N.
+
+. /lib/functions.sh
+[ "$(board_name)" = "dlink,dsr-1000n" ] || exit 0
+
+/etc/init.d/octeon-accel enable
+
+if [ -z "$(uci -q get firewall.@defaults[0].flow_offloading)" ]; then
+	uci -q set firewall.@defaults[0].flow_offloading='1'
+	uci -q commit firewall
+fi
+exit 0
diff --git a/files/etc/uci-defaults/93-dsr1000n-wan-eth1 b/files/etc/uci-defaults/93-dsr1000n-wan-eth1
new file mode 100755
index 0000000..2dc3f3a
--- /dev/null
+++ b/files/etc/uci-defaults/93-dsr1000n-wan-eth1
@@ -0,0 +1,61 @@
+#!/bin/sh
+# D-Link DSR-1000N: give WAN1 its own link into the CPU, as D-Link's firmware did.
+#
+# Switch port 5 is wired to the Octeon's second RGMII port (eth1). With the
+# "wanlink" switch port (patches 173/174), WAN1 and port 5 are bridged inside
+# the switch (br-wan, hardware forwarded, no IP) and the WAN interface uses eth1:
+# WAN traffic no longer shares the LAN's link (eth0) and arrives untagged.
+#
+# Only converts the stock layout (WAN on the "wan" switch port). To go back:
+#   uci set network.wan.device=wan; uci set network.wan6.device=wan
+#   uci delete network.br_wan_dev; uci delete network.wanlink; uci commit network
+
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "dlink,dsr-1000n" ] || exit 0
+[ -d /sys/class/net/wanlink ] || exit 0		# kernel without the port 5 link
+[ -d /sys/class/net/eth1 ] || exit 0
+[ "$(uci -q get network.wan.device)" = "wan" ] || exit 0
+
+for i in wan wan6; do
+	[ "$(uci -q get network.$i.device)" = "wan" ] && uci set network.$i.device='eth1'
+done
+
+uci -q delete network.br_wan_dev
+uci set network.br_wan_dev=device
+uci set network.br_wan_dev.type='bridge'
+uci set network.br_wan_dev.name='br-wan'
+uci add_list network.br_wan_dev.ports='wan'
+uci add_list network.br_wan_dev.ports='wanlink'
+
+uci -q delete network.wanlink
+uci set network.wanlink=interface
+uci set network.wanlink.proto='none'
+uci set network.wanlink.device='br-wan'
+
+# Keep WAN1's MAC address (D-Link base MAC + 1) on the new WAN device, eth1.
+# The switch-side "wan" port and br-wan carry no IP; they get the locally
+# administered variant of it, so the switch never sees the router's own MAC
+# on its CPU port (that would steer WAN traffic for eth1 to the wrong link).
+. /lib/functions/system.sh
+. /usr/share/libubox/jshn.sh
+json_init
+json_load "$(cat /etc/board.json)"
+mac=
+if json_select network 2>/dev/null && json_select wan 2>/dev/null; then
+	json_get_var mac macaddr
+fi
+if [ -n "$mac" ]; then
+	dev_section() {
+		local s
+		s=$(uci show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='$1'$/\1/p" | head -1)
+		[ -n "$s" ] || s=$(uci add network device)
+		uci set network.$s.name="$1"
+		echo "$s"
+	}
+	la=$(macaddr_setbit_la "$mac")
+	uci set network.$(dev_section eth1).macaddr="$mac"
+	uci set network.$(dev_section wan).macaddr="$la"
+	uci set network.br_wan_dev.macaddr="$la"
+fi
+
+uci commit network
+exit 0
diff --git a/files/etc/uci-defaults/94-dsr1000n-fstab b/files/etc/uci-defaults/94-dsr1000n-fstab
new file mode 100755
index 0000000..42a51ab
--- /dev/null
+++ b/files/etc/uci-defaults/94-dsr1000n-fstab
@@ -0,0 +1,32 @@
+#!/bin/sh
+# USB storage: mount any USB drive automatically under /mnt/<device> (e.g. for
+# file sharing). Without /etc/config/fstab block-mount mounts nothing, and the
+# stock default (block detect) leaves unknown drives unmounted. Creates the
+# config if missing and enables auto-mount for USB drives, unless mounts are
+# already set up by hand. The router's own flash partitions are never mounted.
+
+command -v block >/dev/null || exit 0
+[ -f /etc/config/fstab ] || block detect > /etc/config/fstab 2>/dev/null
+uci -q get fstab.@global[0] >/dev/null || uci -q add fstab global >/dev/null
+
+# leave a hand-made configuration alone (mounts for anything but internal flash)
+uci -q show fstab | grep "^fstab\.[^.]*\.device=" | grep -vq "/dev/mtdblock" && exit 0
+uci -q show fstab | grep -q "^fstab\.[^.]*\.\(uuid\|label\|target\)=" && exit 0
+
+# Internal flash (rootfs, overlay, D-Link config) must stay out of /mnt.
+# A disabled entry would be ignored and anon_mount would mount it anyway;
+# an autofs entry is never mounted by 'block mount' or hotplug (no blockd).
+for d in /dev/mtdblock*; do
+	[ -b "$d" ] || continue
+	n=${d#/dev/}
+	uci -q show fstab | grep -q "\.device='/dev/$n'$" && continue
+	s=$(uci add fstab mount)
+	uci set fstab.$s.device="/dev/$n"
+	uci set fstab.$s.enabled='1'
+	uci set fstab.$s.autofs='1'
+done
+
+uci set fstab.@global[0].anon_mount='1'
+uci set fstab.@global[0].auto_mount='1'
+uci commit fstab
+exit 0
