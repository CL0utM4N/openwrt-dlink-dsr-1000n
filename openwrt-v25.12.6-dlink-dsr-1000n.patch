+		echo "dlink,dsr-1000n" > /tmp/sysinfo/board_name
+		echo "D-Link DSR-1000N" > /tmp/sysinfo/model
+		return 0
+	fi
+
 	case "$of_machine" in
 	"cisco,vedge1000"*)
 		return 0
