diff --git a/target/linux/octeon/patches-6.12/173-dts-dlink-dsr-1000n-wanlink.patch b/target/linux/octeon/patches-6.12/173-dts-dlink-dsr-1000n-wanlink.patch
new file mode 100755
index 0000000..ab83daf
--- /dev/null
+++ b/target/linux/octeon/patches-6.12/173-dts-dlink-dsr-1000n-wanlink.patch
@@ -0,0 +1,35 @@
+From: Lachlan Green <69705346+CL0utM4N@users.noreply.github.com>
+Subject: [PATCH] dts: dlink-dsr-1000n: switch port 5 <-> eth1 as "wanlink"
+
+Switch port 5 is wired to the Octeon's second RGMII port (eth1); D-Link's
+firmware used it as the WAN path (port-based VLAN WAN1 + port 5). Describe
+it as a user port with the same fixed RGMII link as the CPU port, so it can
+be bridged with "wan" in the switch and WAN traffic gets its own untagged
+link into the CPU.
+
+diff -Nurp a/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts b/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts
+--- a/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts	2026-11-11 22:00:03.248122961 +1100
++++ b/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts	2026-11-11 22:00:03.290143639 +1100
+@@ -94,6 +94,22 @@
+ 				reg = <4>;
+ 				label = "wan";
+ 			};
++			/*
++			 * Port 5 is wired to the Octeon's second RGMII port (eth1),
++			 * which D-Link used as the WAN path. As a user port it can be
++			 * bridged with "wan" in the switch, giving WAN traffic its
++			 * own untagged link into the CPU.
++			 */
++			port@5 {
++				reg = <5>;
++				label = "wanlink";
++				phy-mode = "rgmii-id";
++
++				fixed-link {
++					speed = <1000>;
++					full-duplex;
++				};
++			};
+ 			port@8 {
+ 				reg = <8>;
+ 				ethernet = <&{/soc@0/pip@11800a0000000/interface@0/ethernet@0}>;
diff --git a/target/linux/octeon/patches-6.12/174-net-dsa-b53-rgmii-on-531x5-port5.patch b/target/linux/octeon/patches-6.12/174-net-dsa-b53-rgmii-on-531x5-port5.patch
new file mode 100755
index 0000000..4e1b148
--- /dev/null
+++ b/target/linux/octeon/patches-6.12/174-net-dsa-b53-rgmii-on-531x5-port5.patch
@@ -0,0 +1,40 @@
+From: Lachlan Green <69705346+CL0utM4N@users.noreply.github.com>
+Subject: [PATCH] net: dsa: b53: enable BCM53115 port 5, advertise its RGMII
+
+The BCM53115 has an RGMII-capable port 5 besides the IMP port, but its
+chip table entry leaves it out of enabled_ports (0x11f), so every
+per-port setup (default VLAN membership, bridge masks, jumbo) skips it:
+a user port on port 5 links up but the switch drops frames forwarded to
+it. Add port 5 (0x13f); an unused port 5 is still disabled as before.
+
+b53_phylink_mac_config() programs RGMII delays for BCM531x5 ports, but
+b53_phylink_get_caps() only advertised RGMII for BCM63xx, so phylink
+rejected an RGMII user port on port 5. Advertise it for port 5 and IMP.
+
+diff -Nurp a/drivers/net/dsa/b53/b53_common.c b/drivers/net/dsa/b53/b53_common.c
