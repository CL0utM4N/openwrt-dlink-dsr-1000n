+--- a/arch/mips/crypto/Kconfig	2026-11-11 11:53:16.984067996 +1100
++++ b/arch/mips/crypto/Kconfig	2026-11-12 10:31:06.273447342 +1100
+@@ -22,6 +22,56 @@ config CRYPTO_POLY1305_MIPS
