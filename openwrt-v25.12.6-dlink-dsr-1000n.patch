diff --git a/files/etc/hotplug.d/net/30-flowtable-wifi b/files/etc/hotplug.d/net/30-flowtable-wifi
new file mode 100755
index 0000000..fb67074
--- /dev/null
+++ b/files/etc/hotplug.d/net/30-flowtable-wifi
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Wi-Fi interfaces (access point, client) are created after the firewall has
+# built its software flowtable, and fw4 only collects flowtable devices on a
+# full reload. Add each new Wi-Fi interface to the running flowtable so its
+# flows are offloaded (the next firewall reload includes it anyway).
+
+[ "$ACTION" = add ] || exit 0
+[ "$DEVTYPE" = wlan ] || exit 0
+dev="${INTERFACE:-$DEVICENAME}"
+[ -n "$dev" ] || exit 0
+[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = 1 ] || exit 0
+
+ft="$(nft list flowtable inet fw4 ft 2>/dev/null)" || exit 0
+case "$ft" in
+*"\"$dev\""*) exit 0 ;;
+esac
+nft add flowtable inet fw4 ft "{ hook ingress priority filter; devices = { \"$dev\" }; }" 2>/dev/null
+exit 0
diff --git a/files/etc/init.d/octeon-accel b/files/etc/init.d/octeon-accel
new file mode 100755
index 0000000..c78eb77
--- /dev/null
+++ b/files/etc/init.d/octeon-accel
@@ -0,0 +1,63 @@
+#!/bin/sh /etc/rc.common
+# Octeon Ethernet forwarding accelerations, configured in /etc/config/octeon_accel:
+#   fastpath        - hand offloaded flows to the flowtable straight from the RX
+#                     loop (needs Network -> Firewall -> Software flow offloading)
+#   skb_reuse       - return transmitted buffers directly to the hardware RX pool
+#   conduit_noqueue - no qdisc on the Octeon ports (eth0 = DSA conduit, eth1,
+#                     eth2). SQM/cake can go on any device: shapers are left
+#                     alone here, and octeon-fwd and the fast path step aside
+#                     for shaped ports so SQM sees every packet.
+#   wqe_fwd         - octeon-fwd: forward offloaded flows straight from the RX
+#                     hardware buffer (kmod-octeon-fwd)
+#   des3            - hardware Triple DES (kmod-crypto-des3-octeon). 3DES is
+#                     obsolete; only for old VPN peers. Default off.
+# All but des3 default to on. "/etc/init.d/octeon-accel reload" applies changes.
+
+START=19
+
+apply() {
+	local p=/sys/module/octeon_ethernet/parameters
+	local fastpath skb_reuse noqueue wqe des3 dev
+
+	[ -d "$p" ] || return 0
+	config_load octeon_accel
+	config_get_bool fastpath main fastpath 1
+	config_get_bool skb_reuse main skb_reuse 1
+	config_get_bool noqueue main conduit_noqueue 1
+	config_get_bool wqe main wqe_fwd 1
+	config_get_bool des3 main des3 0
+	if [ "$des3" = 1 ]; then
+		modprobe octeon-des3 2>/dev/null
+	elif [ -d /sys/module/octeon_des3 ]; then
+		rmmod octeon_des3 2>/dev/null	# fails harmlessly while in use
+	fi
+	[ -w "$p/fastpath" ] && echo "$fastpath" > "$p/fastpath"
+	[ -w "$p/skb_reuse" ] && echo "$skb_reuse" > "$p/skb_reuse"
+	[ -w /sys/module/octeon_fwd/parameters/enable ] &&
+		echo "$wqe" > /sys/module/octeon_fwd/parameters/enable
+
+	command -v tc >/dev/null || return 0
+	for dev in /sys/class/net/*; do
+		dev="${dev##*/}"
+		# every Octeon port: the DSA conduit (eth0), eth1, eth2/wan2
+		case "$(readlink /sys/class/net/$dev/device/driver 2>/dev/null)" in
+		*/octeon_ethernet) ;;
+		*) [ -d "/sys/class/net/$dev/dsa" ] || continue ;;
+		esac
+		# leave shapers alone (SQM's cake/htb/hfsc, anything set by hand):
+		# only the default qdiscs are swapped for noqueue or restored
+		case "$(tc qdisc show dev "$dev" root 2>/dev/null | awk '{ print $2; exit }')" in
+		""|noqueue|fq_codel|pfifo_fast|mq) ;;
+		*) continue ;;
+		esac
+		if [ "$noqueue" = 1 ]; then
+			tc qdisc replace dev "$dev" root noqueue 2>/dev/null
+		else
+			tc qdisc del dev "$dev" root 2>/dev/null
+		fi
+	done
+	return 0
+}
+
+start() { apply; }
+reload() { apply; }
diff --git a/files/etc/uci-defaults/90-dsr1000n-wan2-mac b/files/etc/uci-defaults/90-dsr1000n-wan2-mac
new file mode 100755
index 0000000..bb8a872
--- /dev/null
+++ b/files/etc/uci-defaults/90-dsr1000n-wan2-mac
@@ -0,0 +1,17 @@
+#!/bin/sh
+# D-Link DSR-1000N: give the WAN2/DMZ port its real MAC (base + 2 from D-Link product data,
+# already computed into board.json) even before it is assigned to an interface.
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "dlink,dsr-1000n" ] || exit 0
+. /usr/share/libubox/jshn.sh
+json_init
+json_load "$(cat /etc/board.json)"
+json_select network_device 2>/dev/null || exit 0
+json_select wan2 2>/dev/null || exit 0
+json_get_var mac macaddr
+[ -n "$mac" ] || exit 0
+for s in $(uci -q show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='wan2'$/\1/p"); do exit 0; done
+s=$(uci add network device)
+uci set network.$s.name='wan2'
+uci set network.$s.macaddr="$mac"
+uci commit network
+exit 0
diff --git a/files/etc/uci-defaults/91-dsr1000n-wifi-name b/files/etc/uci-defaults/91-dsr1000n-wifi-name
new file mode 100755
index 0000000..36a3e8e
--- /dev/null
+++ b/files/etc/uci-defaults/91-dsr1000n-wifi-name
@@ -0,0 +1,29 @@
+#!/bin/sh
+# The DSR-1000N's stock AR9160 mini-PCI card reports the Atheros reference
+# subsystem ID 168c:2082. OpenWrt's Wi-Fi hardware tables list that ID as
+# "Ubiquiti SR71A" with a +7 dB TX power offset (the SR71A's external
+# amplifier), so LuCI showed the wrong card name and a TX power 7 dB too high.
+# Correct that one entry, on this board only, in both tables:
+#   /usr/share/libiwinfo/devices.txt  (libiwinfo: LuCI, ubus iwinfo)
+#   /usr/share/wifi_devices.json      (ucode iwinfo CLI)
+
+. /lib/functions.sh
+[ "$(board_name)" = "dlink,dsr-1000n" ] || exit 0
+
+fix() {
+	local f="$1" from="$2" to="$3"
+	[ -f "$f" ] || return 0
+	grep -q "$from" "$f" || return 0
+	sed "s/$from/$to/" "$f" > /tmp/wifiname.$$ && cat /tmp/wifiname.$$ > "$f"
+	rm -f /tmp/wifiname.$$
+}
+
+fix /usr/share/libiwinfo/devices.txt \
+	'^0x168c 0x0027 0x168c 0x2082 .*"SR71A"$' \
+	'0x168c 0x0027 0x168c 0x2082    0      0  "Atheros" "AR9160"'
+
+fix /usr/share/wifi_devices.json \
+	'\[ "0x168c", "0x0027", "0x168c", "0x2082", 7, 0, "Ubiquiti", "SR71A" \]' \
+	'[ "0x168c", "0x0027", "0x168c", "0x2082", 0, 0, "Atheros", "AR9160" ]'
+
+exit 0
diff --git a/files/etc/uci-defaults/92-dsr1000n-octeon-accel b/files/etc/uci-defaults/92-dsr1000n-octeon-accel
