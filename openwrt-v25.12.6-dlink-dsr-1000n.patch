+		;;
+	esac
+
 	if [ ! -b "${rootfs}" ] && [ "${board}" = "cisco,vedge1000" ]; then
 		# Default to the built-in USB disk for N821
 		rootfs="$(platform_get_n821_disk 2)"
@@ -155,6 +164,13 @@ platform_check_image() {
