diff --git a/target/linux/octeon/base-files/lib/preinit/01_sysinfo b/target/linux/octeon/base-files/lib/preinit/01_sysinfo
old mode 100644
new mode 100755
index 53ac1fe..eb4cf0b
--- a/target/linux/octeon/base-files/lib/preinit/01_sysinfo
+++ b/target/linux/octeon/base-files/lib/preinit/01_sysinfo
@@ -8,6 +8,15 @@ do_sysinfo_octeon() {
 	# Sadly for whatever reason the N821 (Cisco Viptela vEdge 1000) uses the
 	# same supposedly unique board ID as the EdgeRouter. This is bad, so
 	# we override what cpuinfo gives us using the device tree as a hint.
+	# D-Link DSR-1000N: U-Boot reports board type 20006, which the kernel now
+	# names ITUS_SHIELD; trust the device tree model instead.
+	if [ "$(cat /sys/firmware/devicetree/base/model 2>/dev/null)" = "dlink,dsr-1000n" ]; then
+		mkdir -p /tmp/sysinfo
+		echo "dlink,dsr-1000n" > /tmp/sysinfo/board_name
+		echo "D-Link DSR-1000N" > /tmp/sysinfo/model
+		return 0
+	fi
+
 	case "$of_machine" in
 	"cisco,vedge1000"*)
 		return 0
