#!/bin/sh /etc/rc.common
# Octeon Ethernet forwarding accelerations (patches 166/167), configured in
# /etc/config/octeon_accel:
#   fastpath  - hand offloaded flows to the flowtable straight from the RX loop
#               (needs Network -> Firewall -> Software flow offloading)
#   skb_reuse - return transmitted buffers directly to the hardware RX pool
# Both default to on. "/etc/init.d/octeon-accel reload" applies changes.

START=19

apply() {
	local p=/sys/module/octeon_ethernet/parameters
	local fastpath skb_reuse

	[ -d "$p" ] || return 0
	config_load octeon_accel
	config_get_bool fastpath main fastpath 1
	config_get_bool skb_reuse main skb_reuse 1
	[ -w "$p/fastpath" ] && echo "$fastpath" > "$p/fastpath"
	[ -w "$p/skb_reuse" ] && echo "$skb_reuse" > "$p/skb_reuse"
	return 0
}

start() { apply; }
reload() { apply; }
