+static int octeon_gcm_kat(void)
+{
+	struct octeon_gcm_ctx ctx;
+	u8 out[60], tag[16];
+	int bad = 0;
+
+	octeon_gcm_aes_setkey(&ctx, tc4_key, 16);
+	gcm_linear(&ctx, tc4_iv, tc4_aad, 20, out, tc4_pt, 60, true, tag);
+	if (memcmp(out, tc4_ct, 60) || memcmp(tag, tc4_tag, 16)) {
+		pr_err("octeon-gcm: encrypt known-answer test failed\n");
+		pr_err("octeon-gcm: tag %16phN\n", tag);
+		bad = 1;
+	}
+	memcpy(out, tc4_ct, 60);
+	gcm_linear(&ctx, tc4_iv, tc4_aad, 20, out, out, 60, false, tag);
+	if (memcmp(out, tc4_pt, 60) || memcmp(tag, tc4_tag, 16)) {
+		pr_err("octeon-gcm: decrypt known-answer test failed\n");
+		bad = 1;
+	}
+	memzero_explicit(&ctx, sizeof(ctx));
+	return bad ? -EIO : 0;
+}
