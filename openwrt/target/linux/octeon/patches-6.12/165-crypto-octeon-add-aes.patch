+/* Random cross-check against gcm_base(ctr(aes-generic),ghash-generic). */
+static int octeon_gcm_check(void)
+{
+	static const unsigned int alens[] = { 0, 8, 20, 33, 300 };
+	static const unsigned int plens[] = { 0, 1, 15, 16, 17, 60, 1000 };
+	struct crypto_aead *gen;
+	struct aead_request *req = NULL;
+	struct octeon_gcm_ctx ctx;
+	struct scatterlist sg;
+	DECLARE_CRYPTO_WAIT(wait);
+	u8 key[32], iv[12], tag[16], *buf, *src, *hw;
+	int kl, i, j, bad = 0, err;
+
+	gen = crypto_alloc_aead("gcm_base(ctr(aes-generic),ghash-generic)", 0,
+				CRYPTO_ALG_ASYNC);
+	if (IS_ERR(gen))
+		return PTR_ERR(gen);
+	err = crypto_aead_setauthsize(gen, 16);
+	buf = kmalloc(3 * 1400, GFP_KERNEL);
+	req = aead_request_alloc(gen, GFP_KERNEL);
+	if (err || !buf || !req) {
+		err = err ?: -ENOMEM;
+		goto out;
+	}
+	src = buf + 1400;
+	hw = src + 1400;
+	for (kl = 16; kl <= 32 && !bad; kl += 8) {
+		for (i = 0; i < ARRAY_SIZE(alens) && !bad; i++) {
+			for (j = 0; j < ARRAY_SIZE(plens) && !bad; j++) {
+				unsigned int al = alens[i], pl = plens[j];
+
+				get_random_bytes(key, sizeof(key));
+				get_random_bytes(iv, sizeof(iv));
+				get_random_bytes(src, al + pl);
+				if ((kl + i + j) & 1)	/* counter near inc32 wrap */
+					memset(iv + 8, 0xff, 4);
+				memcpy(buf, src, al + pl);
+				err = crypto_aead_setkey(gen, key, kl);
+				if (err)
+					goto out;
+				sg_init_one(&sg, buf, al + pl + 16);
+				aead_request_set_callback(req, 0, crypto_req_done, &wait);
+				aead_request_set_crypt(req, &sg, &sg, pl, iv);
+				aead_request_set_ad(req, al);
+				err = crypto_wait_req(crypto_aead_encrypt(req), &wait);
+				if (err)
+					goto out;
+				octeon_gcm_aes_setkey(&ctx, key, kl);
+				gcm_linear(&ctx, iv, src, al, hw, src + al, pl,
+					   true, tag);
+				if (memcmp(hw, buf + al, pl) ||
+				    memcmp(tag, buf + al + pl, 16)) {
+					pr_err("octeon-gcm: mismatch vs generic (AES-%d, aad %u, len %u)\n",
+					       kl * 8, al, pl);
+					bad = 1;
+				}
+				/* and back, in place */
+				gcm_linear(&ctx, iv, src, al, hw, hw, pl, false, tag);
+				if (memcmp(hw, src + al, pl) ||
+				    memcmp(tag, buf + al + pl, 16)) {
+					pr_err("octeon-gcm: decrypt mismatch (AES-%d, aad %u, len %u)\n",
+					       kl * 8, al, pl);
+					bad = 1;
+				}
+			}
+		}
+	}
+	err = bad ? -EIO : 0;
+out:
+	memzero_explicit(&ctx, sizeof(ctx));
+	memzero_explicit(key, sizeof(key));
+	aead_request_free(req);
+	kfree(buf);
+	crypto_free_aead(gen);
+	return err;
+}
