From: Lachlan Green <69705346+CL0utM4N@users.noreply.github.com>
Subject: [PATCH] crypto: octeon - add AES (ECB, CBC, CTR), GHASH, AES-GCM and 3DES

Mainline only uses the OCTEON crypto coprocessor for MD5 and SHA-1/2.
Add drivers for its AES unit (block cipher plus native ECB, CBC and CTR),
its Galois-field multiplier (GHASH), a one-pass AES-GCM AEAD (gcm(aes)
and rfc4106(gcm(aes)), the AES unit and the multiplier working in
parallel: ~2.4x the gcm template on the other two drivers) and its 3DES
unit (block cipher, ECB, CBC). Each module checks itself at load
(FIPS-197 / SP 800-38A / GCM specification vectors, cross-checks against
the generic implementations with random data and odd splits) and
refuses to register on any mismatch.

diff -Nurp a/arch/mips/cavium-octeon/crypto/Makefile b/arch/mips/cavium-octeon/crypto/Makefile
--- a/arch/mips/cavium-octeon/crypto/Makefile	2026-11-11 11:53:16.997021015 +1100
+++ b/arch/mips/cavium-octeon/crypto/Makefile	2026-11-12 10:31:06.272805836 +1100
@@ -6,6 +6,10 @@
 obj-y += octeon-crypto.o
 
 obj-$(CONFIG_CRYPTO_MD5_OCTEON)		+= octeon-md5.o
+obj-$(CONFIG_CRYPTO_AES_OCTEON)		+= octeon-aes.o
+obj-$(CONFIG_CRYPTO_GHASH_OCTEON)	+= octeon-ghash.o
+obj-$(CONFIG_CRYPTO_AES_GCM_OCTEON)	+= octeon-gcm.o
+obj-$(CONFIG_CRYPTO_DES3_OCTEON)	+= octeon-des3.o
 obj-$(CONFIG_CRYPTO_SHA1_OCTEON)	+= octeon-sha1.o
 obj-$(CONFIG_CRYPTO_SHA256_OCTEON)	+= octeon-sha256.o
 obj-$(CONFIG_CRYPTO_SHA512_OCTEON)	+= octeon-sha512.o
diff -Nurp a/arch/mips/cavium-octeon/crypto/octeon-aes.c b/arch/mips/cavium-octeon/crypto/octeon-aes.c
--- a/arch/mips/cavium-octeon/crypto/octeon-aes.c	1970-01-01 10:00:00.000000000 +1000
+++ b/arch/mips/cavium-octeon/crypto/octeon-aes.c	2026-11-12 10:31:06.252404253 +1100
@@ -0,0 +1,607 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AES using the OCTEON crypto coprocessor (COP2).
+ *
+ * Provides the "aes" block cipher (so the generic gcm/ccm/xts templates use
+ * the hardware) plus native "ecb(aes)", "cbc(aes)" and "ctr(aes)" skciphers.
+ *
+ * COP2 register selectors as used by the Cavium OCTEON SDK (cvmx-asm.h):
+ *   0x0100-0x0101  AES result (read)
+ *   0x0102-0x0103  AES IV
+ *   0x0104-0x0107  AES key (always 4 dwords, zero padded)
+ *   0x0110         AES key length: (key bits / 64) - 1
+ *   0x0108/0x3109  CBC encrypt dword 0 / dword 1 (writing dword 1 starts it)
+ *   0x010a/0x310b  ECB encrypt
+ *   0x010c/0x310d  CBC decrypt
+ *   0x010e/0x310f  ECB decrypt
+ * In CBC mode the unit keeps the chaining value in the IV registers itself.
+ */
+
+#include <crypto/aes.h>
+#include <crypto/algapi.h>
+#include <crypto/internal/cipher.h>
+#include <crypto/internal/skcipher.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <asm/octeon/octeon.h>
+
+#include "octeon-crypto.h"
+
+#define OCT_MT(val, sel) \
+	__asm__ __volatile__("dmtc2 %[rt]," #sel : : [rt] "d" ((u64)(val)))
+#define OCT_MF(sel) ({ u64 __v; \
+	__asm__ __volatile__("dmfc2 %[rt]," #sel : [rt] "=d" (__v)); __v; })
+
+struct octeon_aes_ctx {
+	u64 key[4];
+	u64 keylen_code;
+};
+
+static int octeon_aes_expand(struct octeon_aes_ctx *ctx, const u8 *key,
+			     unsigned int keylen)
+{
+	u8 buf[AES_MAX_KEY_SIZE] = { 0 };
+	int i, err;
+
+	err = aes_check_keylen(keylen);
+	if (err)
+		return err;
+	memcpy(buf, key, keylen);
+	for (i = 0; i < 4; i++)
+		ctx->key[i] = get_unaligned_be64(buf + 8 * i);
+	ctx->keylen_code = keylen * 8 / 64 - 1;
+	memzero_explicit(buf, sizeof(buf));
+	return 0;
+}
+
+static inline void octeon_aes_load_key(const struct octeon_aes_ctx *ctx)
+{
+	OCT_MT(ctx->key[0], 0x0104);
+	OCT_MT(ctx->key[1], 0x0105);
+	OCT_MT(ctx->key[2], 0x0106);
+	OCT_MT(ctx->key[3], 0x0107);
+	OCT_MT(ctx->keylen_code, 0x0110);
+}
+
+/* All helpers below must run between octeon_crypto_enable()/disable(). */
+
+static void octeon_aes_ecb_blocks(const struct octeon_aes_ctx *ctx, u8 *dst,
+				  const u8 *src, unsigned int nblocks, bool enc)
+{
+	octeon_aes_load_key(ctx);
+	while (nblocks--) {
+		u64 a = get_unaligned_be64(src), b = get_unaligned_be64(src + 8);
+
+		if (enc) {
+			OCT_MT(a, 0x010a);
+			OCT_MT(b, 0x310b);
+		} else {
+			OCT_MT(a, 0x010e);
+			OCT_MT(b, 0x310f);
+		}
+		put_unaligned_be64(OCT_MF(0x0100), dst);
+		put_unaligned_be64(OCT_MF(0x0101), dst + 8);
+		src += AES_BLOCK_SIZE;
+		dst += AES_BLOCK_SIZE;
+	}
+}
+
+/* Updates iv[] to the chaining value for the next call. */
+static void octeon_aes_cbc_blocks(const struct octeon_aes_ctx *ctx, u8 *dst,
+				  const u8 *src, unsigned int nblocks, u8 *iv,
+				  bool enc)
+{
+	u64 a = 0, b = 0;
+
+	octeon_aes_load_key(ctx);
+	OCT_MT(get_unaligned_be64(iv), 0x0102);
+	OCT_MT(get_unaligned_be64(iv + 8), 0x0103);
+	while (nblocks--) {
+		u64 r0, r1;
+
+		/* read the input first: src may equal dst */
+		a = get_unaligned_be64(src);
+		b = get_unaligned_be64(src + 8);
+		if (enc) {
+			OCT_MT(a, 0x0108);
+			OCT_MT(b, 0x3109);
+		} else {
+			OCT_MT(a, 0x010c);
+			OCT_MT(b, 0x310d);
+		}
+		r0 = OCT_MF(0x0100);
+		r1 = OCT_MF(0x0101);
+		put_unaligned_be64(r0, dst);
+		put_unaligned_be64(r1, dst + 8);
+		if (enc) {
+			a = r0;
+			b = r1;
+		}
+		src += AES_BLOCK_SIZE;
+		dst += AES_BLOCK_SIZE;
+	}
+	/* next IV = last ciphertext block */
+	put_unaligned_be64(a, iv);
+	put_unaligned_be64(b, iv + 8);
+}
+
+/*
+ * CTR: big-endian 128-bit counter in iv[], encrypted with the ECB path in one
+ * COP2 session. Handles a trailing partial block (keystream truncated, counter
+ * still advanced, as crypto/ctr.c does). Updates iv[].
+ */
+static void octeon_aes_ctr_bytes(const struct octeon_aes_ctx *ctx, u8 *dst,
+				 const u8 *src, unsigned int nbytes, u8 *iv)
+{
+	u64 c0 = get_unaligned_be64(iv), c1 = get_unaligned_be64(iv + 8);
+
+	octeon_aes_load_key(ctx);
+	while (nbytes) {
+		unsigned int n = min_t(unsigned int, nbytes, AES_BLOCK_SIZE);
+		u64 k0, k1;
+
+		OCT_MT(c0, 0x010a);
+		OCT_MT(c1, 0x310b);
+		k0 = OCT_MF(0x0100);
+		k1 = OCT_MF(0x0101);
+		if (++c1 == 0)
+			c0++;
+		if (n == AES_BLOCK_SIZE) {
+			put_unaligned_be64(get_unaligned_be64(src) ^ k0, dst);
+			put_unaligned_be64(get_unaligned_be64(src + 8) ^ k1, dst + 8);
+		} else {
+			u8 ks[AES_BLOCK_SIZE];
+
+			put_unaligned_be64(k0, ks);
+			put_unaligned_be64(k1, ks + 8);
+			crypto_xor_cpy(dst, src, ks, n);
+			memzero_explicit(ks, sizeof(ks));
+		}
+		src += n;
+		dst += n;
+		nbytes -= n;
+	}
+	put_unaligned_be64(c0, iv);
+	put_unaligned_be64(c1, iv + 8);
+}
+
+/* ---- "aes" single block cipher ---- */
+
+static int octeon_aes_cipher_setkey(struct crypto_tfm *tfm, const u8 *key,
+				    unsigned int keylen)
+{
+	return octeon_aes_expand(crypto_tfm_ctx(tfm), key, keylen);
+}
+
+static void octeon_aes_cipher_crypt(struct crypto_tfm *tfm, u8 *dst,
+				    const u8 *src, bool enc)
+{
+	struct octeon_cop2_state state;
+	unsigned long flags;
+
+	flags = octeon_crypto_enable(&state);
+	octeon_aes_ecb_blocks(crypto_tfm_ctx(tfm), dst, src, 1, enc);
+	octeon_crypto_disable(&state, flags);
+}
+
+static void octeon_aes_cipher_encrypt(struct crypto_tfm *tfm, u8 *dst,
+				      const u8 *src)
+{
+	octeon_aes_cipher_crypt(tfm, dst, src, true);
+}
+
+static void octeon_aes_cipher_decrypt(struct crypto_tfm *tfm, u8 *dst,
+				      const u8 *src)
+{
+	octeon_aes_cipher_crypt(tfm, dst, src, false);
+}
+
+static struct crypto_alg octeon_aes_cipher_alg = {
+	.cra_name		= "aes",
+	.cra_driver_name	= "aes-octeon",
+	.cra_priority		= OCTEON_CR_OPCODE_PRIORITY,
+	.cra_flags		= CRYPTO_ALG_TYPE_CIPHER,
+	.cra_blocksize		= AES_BLOCK_SIZE,
+	.cra_ctxsize		= sizeof(struct octeon_aes_ctx),
+	.cra_module		= THIS_MODULE,
+	.cra_u.cipher = {
+		.cia_min_keysize	= AES_MIN_KEY_SIZE,
+		.cia_max_keysize	= AES_MAX_KEY_SIZE,
+		.cia_setkey		= octeon_aes_cipher_setkey,
+		.cia_encrypt		= octeon_aes_cipher_encrypt,
+		.cia_decrypt		= octeon_aes_cipher_decrypt,
+	},
+};
+
+/* ---- ecb(aes), cbc(aes) ---- */
+
+static int octeon_aes_sk_setkey(struct crypto_skcipher *tfm, const u8 *key,
+				unsigned int keylen)
+{
+	return octeon_aes_expand(crypto_skcipher_ctx(tfm), key, keylen);
+}
+
+static int octeon_aes_sk_crypt(struct skcipher_request *req, bool cbc,
+			       bool enc)
+{
+	struct octeon_aes_ctx *ctx =
+		crypto_skcipher_ctx(crypto_skcipher_reqtfm(req));
+	struct octeon_cop2_state state;
+	struct skcipher_walk walk;
+	unsigned long flags;
+	unsigned int nbytes;
+	int err;
+
+	err = skcipher_walk_virt(&walk, req, false);
+	while ((nbytes = walk.nbytes)) {
+		unsigned int nblocks = nbytes / AES_BLOCK_SIZE;
+
+		flags = octeon_crypto_enable(&state);
+		if (cbc)
+			octeon_aes_cbc_blocks(ctx, walk.dst.virt.addr,
+					      walk.src.virt.addr, nblocks,
+					      walk.iv, enc);
+		else
+			octeon_aes_ecb_blocks(ctx, walk.dst.virt.addr,
+					      walk.src.virt.addr, nblocks, enc);
+		octeon_crypto_disable(&state, flags);
+		err = skcipher_walk_done(&walk, nbytes % AES_BLOCK_SIZE);
+	}
+	return err;
+}
+
+static int octeon_aes_ctr_crypt(struct skcipher_request *req)
+{
+	struct octeon_aes_ctx *ctx =
+		crypto_skcipher_ctx(crypto_skcipher_reqtfm(req));
+	struct octeon_cop2_state state;
+	struct skcipher_walk walk;
+	unsigned long flags;
+	unsigned int nbytes;
+	int err;
+
+	err = skcipher_walk_virt(&walk, req, false);
+	while ((nbytes = walk.nbytes)) {
+		unsigned int n = nbytes;
+
+		/* only the very last step may end in a partial block */
+		if (walk.nbytes < walk.total)
+			n = round_down(nbytes, AES_BLOCK_SIZE);
+		flags = octeon_crypto_enable(&state);
+		octeon_aes_ctr_bytes(ctx, walk.dst.virt.addr,
+				     walk.src.virt.addr, n, walk.iv);
+		octeon_crypto_disable(&state, flags);
+		err = skcipher_walk_done(&walk, nbytes - n);
+	}
+	return err;
+}
+
+static int octeon_aes_ecb_encrypt(struct skcipher_request *req)
+{
+	return octeon_aes_sk_crypt(req, false, true);
+}
+
+static int octeon_aes_ecb_decrypt(struct skcipher_request *req)
+{
+	return octeon_aes_sk_crypt(req, false, false);
+}
+
+static int octeon_aes_cbc_encrypt(struct skcipher_request *req)
+{
+	return octeon_aes_sk_crypt(req, true, true);
+}
+
+static int octeon_aes_cbc_decrypt(struct skcipher_request *req)
+{
+	return octeon_aes_sk_crypt(req, true, false);
+}
+
+static struct skcipher_alg octeon_aes_sk_algs[] = {
+	{
+		.base.cra_name		= "ecb(aes)",
+		.base.cra_driver_name	= "ecb-aes-octeon",
+		.base.cra_priority	= OCTEON_CR_OPCODE_PRIORITY,
+		.base.cra_blocksize	= AES_BLOCK_SIZE,
+		.base.cra_ctxsize	= sizeof(struct octeon_aes_ctx),
+		.base.cra_module	= THIS_MODULE,
+		.min_keysize		= AES_MIN_KEY_SIZE,
+		.max_keysize		= AES_MAX_KEY_SIZE,
+		.setkey			= octeon_aes_sk_setkey,
+		.encrypt		= octeon_aes_ecb_encrypt,
+		.decrypt		= octeon_aes_ecb_decrypt,
+	}, {
+		.base.cra_name		= "cbc(aes)",
+		.base.cra_driver_name	= "cbc-aes-octeon",
+		.base.cra_priority	= OCTEON_CR_OPCODE_PRIORITY,
+		.base.cra_blocksize	= AES_BLOCK_SIZE,
+		.base.cra_ctxsize	= sizeof(struct octeon_aes_ctx),
+		.base.cra_module	= THIS_MODULE,
+		.min_keysize		= AES_MIN_KEY_SIZE,
+		.max_keysize		= AES_MAX_KEY_SIZE,
+		.ivsize			= AES_BLOCK_SIZE,
+		.setkey			= octeon_aes_sk_setkey,
+		.encrypt		= octeon_aes_cbc_encrypt,
+		.decrypt		= octeon_aes_cbc_decrypt,
+	}, {
+		.base.cra_name		= "ctr(aes)",
+		.base.cra_driver_name	= "ctr-aes-octeon",
+		.base.cra_priority	= OCTEON_CR_OPCODE_PRIORITY,
+		.base.cra_blocksize	= 1,
+		.base.cra_ctxsize	= sizeof(struct octeon_aes_ctx),
+		.base.cra_module	= THIS_MODULE,
+		.min_keysize		= AES_MIN_KEY_SIZE,
+		.max_keysize		= AES_MAX_KEY_SIZE,
+		.ivsize			= AES_BLOCK_SIZE,
+		.chunksize		= AES_BLOCK_SIZE,
+		.setkey			= octeon_aes_sk_setkey,
+		.encrypt		= octeon_aes_ctr_crypt,
+		.decrypt		= octeon_aes_ctr_crypt,
+	},
+};
+
+/* ---- known-answer tests (FIPS-197 App. C, NIST SP 800-38A F.2) ---- */
+
+static const u8 kat_pt[16] = {
+	0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
+	0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff };
+static const u8 kat_key[32] = {
+	0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+	0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+	0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+	0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f };
+static const u8 kat_ct[3][16] = {
+	{ 0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
+	  0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a },	/* 128 */
+	{ 0xdd, 0xa9, 0x7c, 0xa4, 0x86, 0x4c, 0xdf, 0xe0,
+	  0x6e, 0xaf, 0x70, 0xa0, 0xec, 0x0d, 0x71, 0x91 },	/* 192 */
+	{ 0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
+	  0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89 },	/* 256 */
+};
+
+static const u8 cbc_key[16] = {
+	0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6,
+	0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c };
+static const u8 cbc_iv[16] = {
+	0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+	0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f };
+static const u8 cbc_pt[64] = {
+	0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,
+	0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a,
+	0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c,
+	0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51,
+	0x30, 0xc8, 0x1c, 0x46, 0xa3, 0x5c, 0xe4, 0x11,
+	0xe5, 0xfb, 0xc1, 0x19, 0x1a, 0x0a, 0x52, 0xef,
+	0xf6, 0x9f, 0x24, 0x45, 0xdf, 0x4f, 0x9b, 0x17,
+	0xad, 0x2b, 0x41, 0x7b, 0xe6, 0x6c, 0x37, 0x10 };
+static const u8 cbc_ct[64] = {
+	0x76, 0x49, 0xab, 0xac, 0x81, 0x19, 0xb2, 0x46,
+	0xce, 0xe9, 0x8e, 0x9b, 0x12, 0xe9, 0x19, 0x7d,
+	0x50, 0x86, 0xcb, 0x9b, 0x50, 0x72, 0x19, 0xee,
+	0x95, 0xdb, 0x11, 0x3a, 0x91, 0x76, 0x78, 0xb2,
+	0x73, 0xbe, 0xd6, 0xb8, 0xe3, 0xc1, 0x74, 0x3b,
+	0x71, 0x16, 0xe6, 0x9e, 0x22, 0x22, 0x95, 0x16,
+	0x3f, 0xf1, 0xca, 0xa1, 0x68, 0x1f, 0xac, 0x09,
+	0x12, 0x0e, 0xca, 0x30, 0x75, 0x86, 0xe1, 0xa7 };
+
+static int octeon_aes_kat(void)
+{
+	struct octeon_cop2_state state;
+	struct octeon_aes_ctx ctx;
+	unsigned long flags;
+	u8 out[64], iv[16];
+	int i, bad = 0;
+
+	for (i = 0; i < 3; i++) {
+		octeon_aes_expand(&ctx, kat_key, 16 + 8 * i);
+		flags = octeon_crypto_enable(&state);
+		octeon_aes_ecb_blocks(&ctx, out, kat_pt, 1, true);
+		octeon_aes_ecb_blocks(&ctx, out + 16, kat_ct[i], 1, false);
+		octeon_crypto_disable(&state, flags);
+		if (memcmp(out, kat_ct[i], 16) || memcmp(out + 16, kat_pt, 16)) {
+			pr_err("octeon-aes: AES-%d known-answer test failed\n",
+			       128 + 64 * i);
+			bad = 1;
+		}
+	}
+
+	octeon_aes_expand(&ctx, cbc_key, 16);
+	/* encrypt in two calls to check IV hand-over */
+	memcpy(iv, cbc_iv, 16);
+	flags = octeon_crypto_enable(&state);
+	octeon_aes_cbc_blocks(&ctx, out, cbc_pt, 1, iv, true);
+	octeon_aes_cbc_blocks(&ctx, out + 16, cbc_pt + 16, 3, iv, true);
+	octeon_crypto_disable(&state, flags);
+	if (memcmp(out, cbc_ct, 64) || memcmp(iv, cbc_ct + 48, 16)) {
+		pr_err("octeon-aes: CBC encrypt known-answer test failed\n");
+		pr_err("octeon-aes: got %64phN\n", out);
+		pr_err("octeon-aes: iv  %16phN\n", iv);
+		bad = 1;
+	}
+	/* decrypt in place, also split */
+	memcpy(out, cbc_ct, 64);
+	memcpy(iv, cbc_iv, 16);
+	flags = octeon_crypto_enable(&state);
+	octeon_aes_cbc_blocks(&ctx, out, out, 3, iv, false);
+	octeon_aes_cbc_blocks(&ctx, out + 48, out + 48, 1, iv, false);
+	octeon_crypto_disable(&state, flags);
+	if (memcmp(out, cbc_pt, 64) || memcmp(iv, cbc_ct + 48, 16)) {
+		pr_err("octeon-aes: CBC decrypt known-answer test failed\n");
+		pr_err("octeon-aes: got %64phN\n", out);
+		pr_err("octeon-aes: iv  %16phN\n", iv);
+		bad = 1;
+	}
+	memzero_explicit(&ctx, sizeof(ctx));
+	return bad ? -EIO : 0;
+}
+
+/*
+ * CTR cross-check against aes-generic: random key, counter close to a 64-bit
+ * carry, data split at odd offsets including partial blocks.
+ */
+static int octeon_aes_ctr_check(void)
+{
+	static const unsigned int lens[] = { 1, 15, 16, 17, 63, 200, 1000 };
+	struct octeon_cop2_state state;
+	struct crypto_cipher *gen;
+	struct octeon_aes_ctx ctx;
+	u8 key[32], iv0[16], iv[16], ctr[16], ks[16];
+	unsigned long flags;
+	u8 *src, *hw, *ref;
+	int i, j, bad = 0, kl;
+
+	gen = crypto_alloc_cipher("aes-generic", 0, 0);
+	if (IS_ERR(gen))
+		return PTR_ERR(gen);
+	src = kmalloc(3 * 1024, GFP_KERNEL);
+	if (!src) {
+		crypto_free_cipher(gen);
+		return -ENOMEM;
+	}
+	hw = src + 1024;
+	ref = hw + 1024;
+	get_random_bytes(src, 1024);
+
+	for (kl = 16; kl <= 32 && !bad; kl += 8) {
+		get_random_bytes(key, sizeof(key));
+		get_random_bytes(iv0, sizeof(iv0));
+		memset(iv0 + 8, 0xff, 7);	/* low 64 bits about to carry */
+		octeon_aes_expand(&ctx, key, kl);
+		crypto_cipher_setkey(gen, key, kl);
+		for (i = 0; i < ARRAY_SIZE(lens) && !bad; i++) {
+			unsigned int len = lens[i], half = len / 2 & ~15u;
+
+			/* reference: plain CTR with aes-generic */
+			memcpy(ctr, iv0, 16);
+			for (j = 0; j < len; j += 16) {
+				crypto_cipher_encrypt_one(gen, ks, ctr);
+				crypto_xor_cpy(ref + j, src + j, ks,
+					       min_t(unsigned int, 16, len - j));
+				crypto_inc(ctr, 16);
+			}
+			/* hardware, in two calls to check counter hand-over */
+			memcpy(iv, iv0, 16);
+			flags = octeon_crypto_enable(&state);
+			octeon_aes_ctr_bytes(&ctx, hw, src, half, iv);
+			octeon_aes_ctr_bytes(&ctx, hw + half, src + half,
+					     len - half, iv);
+			octeon_crypto_disable(&state, flags);
+			if (memcmp(hw, ref, len) || memcmp(iv, ctr, 16)) {
+				pr_err("octeon-aes: CTR check failed (AES-%d, %u bytes)\n",
+				       kl * 8, len);
+				bad = 1;
+			}
+		}
+	}
+	memzero_explicit(&ctx, sizeof(ctx));
+	memzero_explicit(key, sizeof(key));
+	kfree(src);
+	crypto_free_cipher(gen);
+	return bad ? -EIO : 0;
+}
+
+/* ---- optional benchmark: modprobe octeon-aes bench=1 ---- */
+
+static bool bench;
+module_param(bench, bool, 0444);
+MODULE_PARM_DESC(bench, "Print hardware vs. aes-generic throughput at load");
+
+#define BENCH_LEN	(64 * 1024)
+#define BENCH_ROUNDS	32
+
+static void octeon_aes_bench(void)
+{
+	struct octeon_cop2_state state;
+	struct crypto_cipher *gen;
+	struct octeon_aes_ctx ctx;
+	unsigned long flags;
+	u64 t, ns_hw, ns_cbc, ns_gen;
+	u8 *buf, iv[16] = { 0 };
+	unsigned int i, r;
+
+	buf = kzalloc(BENCH_LEN, GFP_KERNEL);
+	if (!buf)
+		return;
+	octeon_aes_expand(&ctx, kat_key, 16);
+
+	t = ktime_get_ns();
+	for (r = 0; r < BENCH_ROUNDS; r++) {
+		flags = octeon_crypto_enable(&state);
+		octeon_aes_ecb_blocks(&ctx, buf, buf, BENCH_LEN / 16, true);
+		octeon_crypto_disable(&state, flags);
+	}
+	ns_hw = ktime_get_ns() - t;
+
+	t = ktime_get_ns();
+	for (r = 0; r < BENCH_ROUNDS; r++) {
+		flags = octeon_crypto_enable(&state);
+		octeon_aes_cbc_blocks(&ctx, buf, buf, BENCH_LEN / 16, iv, true);
+		octeon_crypto_disable(&state, flags);
+	}
+	ns_cbc = ktime_get_ns() - t;
+
+	ns_gen = 0;
+	gen = crypto_alloc_cipher("aes-generic", 0, 0);
+	if (!IS_ERR(gen)) {
+		crypto_cipher_setkey(gen, kat_key, 16);
+		t = ktime_get_ns();
+		for (r = 0; r < BENCH_ROUNDS; r++)
+			for (i = 0; i < BENCH_LEN; i += 16)
+				crypto_cipher_encrypt_one(gen, buf + i, buf + i);
+		ns_gen = ktime_get_ns() - t;
+		crypto_free_cipher(gen);
+	}
+
+#define MBPS(ns) ((ns) ? (u32)div64_u64((u64)BENCH_LEN * BENCH_ROUNDS * 1000, (ns)) : 0)
+	pr_info("octeon-aes: AES-128 ECB %u MB/s, CBC %u MB/s (hardware); aes-generic %u MB/s\n",
+		MBPS(ns_hw), MBPS(ns_cbc), MBPS(ns_gen));
+	kfree(buf);
+	memzero_explicit(&ctx, sizeof(ctx));
+}
+
+static int __init octeon_aes_mod_init(void)
+{
+	int err;
+
+	if (!octeon_has_crypto())
+		return -ENOTSUPP;
+	err = octeon_aes_kat();
+	if (!err)
+		err = octeon_aes_ctr_check();
+	if (err)
+		return err;
+	pr_info("octeon-aes: self-tests passed (AES-128/192/256, CBC, CTR)\n");
+	if (bench)
+		octeon_aes_bench();
+
+	err = crypto_register_alg(&octeon_aes_cipher_alg);
+	if (err)
+		return err;
+	err = crypto_register_skciphers(octeon_aes_sk_algs,
+					ARRAY_SIZE(octeon_aes_sk_algs));
+	if (err)
+		crypto_unregister_alg(&octeon_aes_cipher_alg);
+	return err;
+}
+
+static void __exit octeon_aes_mod_exit(void)
+{
+	crypto_unregister_skciphers(octeon_aes_sk_algs,
+				    ARRAY_SIZE(octeon_aes_sk_algs));
+	crypto_unregister_alg(&octeon_aes_cipher_alg);
+}
+
+module_init(octeon_aes_mod_init);
+module_exit(octeon_aes_mod_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("AES cipher, ECB, CBC and CTR using the OCTEON crypto coprocessor");
+MODULE_IMPORT_NS(CRYPTO_INTERNAL);
+MODULE_ALIAS_CRYPTO("aes");
+MODULE_ALIAS_CRYPTO("aes-octeon");
+MODULE_ALIAS_CRYPTO("ecb(aes)");
+MODULE_ALIAS_CRYPTO("cbc(aes)");
+MODULE_ALIAS_CRYPTO("ctr(aes)");
diff -Nurp a/arch/mips/cavium-octeon/crypto/octeon-des3.c b/arch/mips/cavium-octeon/crypto/octeon-des3.c
--- a/arch/mips/cavium-octeon/crypto/octeon-des3.c	1970-01-01 10:00:00.000000000 +1000
+++ b/arch/mips/cavium-octeon/crypto/octeon-des3.c	2026-11-12 10:31:06.269874906 +1100
@@ -0,0 +1,364 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Triple DES (3DES-EDE) using the OCTEON crypto coprocessor (COP2): the
+ * "des3_ede" block cipher plus native "ecb(des3_ede)" and "cbc(des3_ede)".
+ * 3DES is obsolete; this is for interoperating with old VPN peers.
+ *
+ * COP2 register selectors as used by the Cavium OCTEON SDK (cvmx-asm.h):
+ *   0x0080-0x0082  3DES keys K1..K3
+ *   0x0084         3DES IV
+ *   0x4088 / 0x408a  CBC / ECB encrypt (starts the operation)
+ *   0x408c / 0x408e  CBC / ECB decrypt
+ *   0x0088         3DES result (read)
+ * In CBC mode the unit keeps the chaining value in the IV register itself.
+ *
+ * The module compares itself against des3_ede-generic at load and refuses to
+ * register on mismatch.
+ */
+
+#include <crypto/algapi.h>
+#include <crypto/des.h>
+#include <crypto/internal/cipher.h>
+#include <crypto/internal/des.h>
+#include <crypto/internal/skcipher.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <asm/octeon/octeon.h>
+
+#include "octeon-crypto.h"
+
+#define OCT_MT(val, sel) \
+	__asm__ __volatile__("dmtc2 %[rt]," #sel : : [rt] "d" ((u64)(val)))
+#define OCT_MF(sel) ({ u64 __v; \
+	__asm__ __volatile__("dmfc2 %[rt]," #sel : [rt] "=d" (__v)); __v; })
+
+struct octeon_des3_ctx {
+	u64 key[3];
+};
+
+static void octeon_des3_expand(struct octeon_des3_ctx *ctx, const u8 *key)
+{
+	ctx->key[0] = get_unaligned_be64(key);
+	ctx->key[1] = get_unaligned_be64(key + 8);
+	ctx->key[2] = get_unaligned_be64(key + 16);
+}
+
+static inline void octeon_des3_load_key(const struct octeon_des3_ctx *ctx)
+{
+	OCT_MT(ctx->key[0], 0x0080);
+	OCT_MT(ctx->key[1], 0x0081);
+	OCT_MT(ctx->key[2], 0x0082);
+}
+
+/* All helpers below must run between octeon_crypto_enable()/disable(). */
+
+static void octeon_des3_ecb_blocks(const struct octeon_des3_ctx *ctx, u8 *dst,
+				   const u8 *src, unsigned int nblocks, bool enc)
+{
+	octeon_des3_load_key(ctx);
+	while (nblocks--) {
+		u64 v = get_unaligned_be64(src);
+
+		if (enc)
+			OCT_MT(v, 0x408a);
+		else
+			OCT_MT(v, 0x408e);
+		put_unaligned_be64(OCT_MF(0x0088), dst);
+		src += DES3_EDE_BLOCK_SIZE;
+		dst += DES3_EDE_BLOCK_SIZE;
+	}
+}
+
+/* Updates iv[] to the chaining value for the next call. */
+static void octeon_des3_cbc_blocks(const struct octeon_des3_ctx *ctx, u8 *dst,
+				   const u8 *src, unsigned int nblocks, u8 *iv,
+				   bool enc)
+{
+	u64 last = 0;
+
+	octeon_des3_load_key(ctx);
+	OCT_MT(get_unaligned_be64(iv), 0x0084);
+	while (nblocks--) {
+		u64 v = get_unaligned_be64(src), r;	/* src may equal dst */
+
+		if (enc)
+			OCT_MT(v, 0x4088);
+		else
+			OCT_MT(v, 0x408c);
+		r = OCT_MF(0x0088);
+		put_unaligned_be64(r, dst);
+		last = enc ? r : v;
+		src += DES3_EDE_BLOCK_SIZE;
+		dst += DES3_EDE_BLOCK_SIZE;
+	}
+	put_unaligned_be64(last, iv);
+}
+
+/* ---- "des3_ede" single block cipher ---- */
+
+static int octeon_des3_cipher_setkey(struct crypto_tfm *tfm, const u8 *key,
+				     unsigned int keylen)
+{
+	int err = crypto_des3_ede_verify_key(tfm, key);
+
+	if (err)
+		return err;
+	octeon_des3_expand(crypto_tfm_ctx(tfm), key);
+	return 0;
+}
+
+static void octeon_des3_cipher_crypt(struct crypto_tfm *tfm, u8 *dst,
+				     const u8 *src, bool enc)
+{
+	struct octeon_cop2_state state;
+	unsigned long flags;
+
+	flags = octeon_crypto_enable(&state);
+	octeon_des3_ecb_blocks(crypto_tfm_ctx(tfm), dst, src, 1, enc);
+	octeon_crypto_disable(&state, flags);
+}
+
+static void octeon_des3_cipher_encrypt(struct crypto_tfm *tfm, u8 *dst,
+				       const u8 *src)
+{
+	octeon_des3_cipher_crypt(tfm, dst, src, true);
+}
+
+static void octeon_des3_cipher_decrypt(struct crypto_tfm *tfm, u8 *dst,
+				       const u8 *src)
+{
+	octeon_des3_cipher_crypt(tfm, dst, src, false);
+}
+
+static struct crypto_alg octeon_des3_cipher_alg = {
+	.cra_name		= "des3_ede",
+	.cra_driver_name	= "des3_ede-octeon",
+	.cra_priority		= OCTEON_CR_OPCODE_PRIORITY,
+	.cra_flags		= CRYPTO_ALG_TYPE_CIPHER,
+	.cra_blocksize		= DES3_EDE_BLOCK_SIZE,
+	.cra_ctxsize		= sizeof(struct octeon_des3_ctx),
+	.cra_module		= THIS_MODULE,
+	.cra_u.cipher = {
+		.cia_min_keysize	= DES3_EDE_KEY_SIZE,
+		.cia_max_keysize	= DES3_EDE_KEY_SIZE,
+		.cia_setkey		= octeon_des3_cipher_setkey,
+		.cia_encrypt		= octeon_des3_cipher_encrypt,
+		.cia_decrypt		= octeon_des3_cipher_decrypt,
+	},
+};
+
+/* ---- ecb(des3_ede), cbc(des3_ede) ---- */
+
+static int octeon_des3_sk_setkey(struct crypto_skcipher *tfm, const u8 *key,
+				 unsigned int keylen)
+{
+	int err = verify_skcipher_des3_key(tfm, key);
+
+	if (err)
+		return err;
+	octeon_des3_expand(crypto_skcipher_ctx(tfm), key);
+	return 0;
+}
+
+static int octeon_des3_sk_crypt(struct skcipher_request *req, bool cbc,
+				bool enc)
+{
+	struct octeon_des3_ctx *ctx =
+		crypto_skcipher_ctx(crypto_skcipher_reqtfm(req));
+	struct octeon_cop2_state state;
+	struct skcipher_walk walk;
+	unsigned long flags;
+	unsigned int nbytes;
+	int err;
+
+	err = skcipher_walk_virt(&walk, req, false);
+	while ((nbytes = walk.nbytes)) {
+		unsigned int nblocks = nbytes / DES3_EDE_BLOCK_SIZE;
+
+		flags = octeon_crypto_enable(&state);
+		if (cbc)
+			octeon_des3_cbc_blocks(ctx, walk.dst.virt.addr,
+					       walk.src.virt.addr, nblocks,
+					       walk.iv, enc);
+		else
+			octeon_des3_ecb_blocks(ctx, walk.dst.virt.addr,
+					       walk.src.virt.addr, nblocks, enc);
+		octeon_crypto_disable(&state, flags);
+		err = skcipher_walk_done(&walk, nbytes % DES3_EDE_BLOCK_SIZE);
+	}
+	return err;
+}
+
+static int octeon_des3_ecb_encrypt(struct skcipher_request *req)
+{
+	return octeon_des3_sk_crypt(req, false, true);
+}
+
+static int octeon_des3_ecb_decrypt(struct skcipher_request *req)
+{
+	return octeon_des3_sk_crypt(req, false, false);
+}
+
+static int octeon_des3_cbc_encrypt(struct skcipher_request *req)
+{
+	return octeon_des3_sk_crypt(req, true, true);
+}
+
+static int octeon_des3_cbc_decrypt(struct skcipher_request *req)
+{
+	return octeon_des3_sk_crypt(req, true, false);
+}
+
+static struct skcipher_alg octeon_des3_sk_algs[] = {
+	{
+		.base.cra_name		= "ecb(des3_ede)",
+		.base.cra_driver_name	= "ecb-des3_ede-octeon",
+		.base.cra_priority	= OCTEON_CR_OPCODE_PRIORITY,
+		.base.cra_blocksize	= DES3_EDE_BLOCK_SIZE,
+		.base.cra_ctxsize	= sizeof(struct octeon_des3_ctx),
+		.base.cra_module	= THIS_MODULE,
+		.min_keysize		= DES3_EDE_KEY_SIZE,
+		.max_keysize		= DES3_EDE_KEY_SIZE,
+		.setkey			= octeon_des3_sk_setkey,
+		.encrypt		= octeon_des3_ecb_encrypt,
+		.decrypt		= octeon_des3_ecb_decrypt,
+	}, {
+		.base.cra_name		= "cbc(des3_ede)",
+		.base.cra_driver_name	= "cbc-des3_ede-octeon",
+		.base.cra_priority	= OCTEON_CR_OPCODE_PRIORITY,
+		.base.cra_blocksize	= DES3_EDE_BLOCK_SIZE,
+		.base.cra_ctxsize	= sizeof(struct octeon_des3_ctx),
+		.base.cra_module	= THIS_MODULE,
+		.min_keysize		= DES3_EDE_KEY_SIZE,
+		.max_keysize		= DES3_EDE_KEY_SIZE,
+		.ivsize			= DES3_EDE_BLOCK_SIZE,
+		.setkey			= octeon_des3_sk_setkey,
+		.encrypt		= octeon_des3_cbc_encrypt,
+		.decrypt		= octeon_des3_cbc_decrypt,
+	},
+};
+
+/*
+ * Cross-check ECB and CBC (both directions, in place, split calls) against
+ * des3_ede-generic with random keys and data.
+ */
+static int octeon_des3_check(void)
+{
+	struct octeon_cop2_state state;
+	struct octeon_des3_ctx ctx;
+	struct crypto_cipher *gen;
+	u8 key[DES3_EDE_KEY_SIZE], iv0[8], iv[8], prev[8];
+	u8 *src, *hw, *ref;
+	unsigned long flags;
+	int round, j, bad = 0;
+	const unsigned int len = 40 * DES3_EDE_BLOCK_SIZE, half = 17 * 8;
+
+	gen = crypto_alloc_cipher("des3_ede-generic", 0, 0);
+	if (IS_ERR(gen))
+		return PTR_ERR(gen);
+	src = kmalloc(3 * len, GFP_KERNEL);
+	if (!src) {
+		crypto_free_cipher(gen);
+		return -ENOMEM;
+	}
+	hw = src + len;
+	ref = hw + len;
+
+	for (round = 0; round < 4 && !bad; round++) {
+		do {
+			get_random_bytes(key, sizeof(key));
+		} while (crypto_cipher_setkey(gen, key, sizeof(key)));
+		get_random_bytes(iv0, sizeof(iv0));
+		get_random_bytes(src, len);
+		octeon_des3_expand(&ctx, key);
+
+		/* ECB encrypt */
+		for (j = 0; j < len; j += 8)
+			crypto_cipher_encrypt_one(gen, ref + j, src + j);
+		flags = octeon_crypto_enable(&state);
+		octeon_des3_ecb_blocks(&ctx, hw, src, len / 8, true);
+		octeon_crypto_disable(&state, flags);
+		bad |= !!memcmp(hw, ref, len);
+
+		/* ECB decrypt, in place */
+		flags = octeon_crypto_enable(&state);
+		octeon_des3_ecb_blocks(&ctx, hw, hw, len / 8, false);
+		octeon_crypto_disable(&state, flags);
+		bad |= !!memcmp(hw, src, len);
+
+		/* CBC encrypt reference */
+		memcpy(prev, iv0, 8);
+		for (j = 0; j < len; j += 8) {
+			crypto_xor_cpy(ref + j, src + j, prev, 8);
+			crypto_cipher_encrypt_one(gen, ref + j, ref + j);
+			memcpy(prev, ref + j, 8);
+		}
+		/* CBC encrypt, two calls to check IV hand-over */
+		memcpy(iv, iv0, 8);
+		flags = octeon_crypto_enable(&state);
+		octeon_des3_cbc_blocks(&ctx, hw, src, half / 8, iv, true);
+		octeon_des3_cbc_blocks(&ctx, hw + half, src + half,
+				       (len - half) / 8, iv, true);
+		octeon_crypto_disable(&state, flags);
+		bad |= !!memcmp(hw, ref, len) || !!memcmp(iv, ref + len - 8, 8);
+
+		/* CBC decrypt, in place, two calls */
+		memcpy(iv, iv0, 8);
+		flags = octeon_crypto_enable(&state);
+		octeon_des3_cbc_blocks(&ctx, hw, hw, half / 8, iv, false);
+		octeon_des3_cbc_blocks(&ctx, hw + half, hw + half,
+				       (len - half) / 8, iv, false);
+		octeon_crypto_disable(&state, flags);
+		bad |= !!memcmp(hw, src, len) || !!memcmp(iv, ref + len - 8, 8);
+		if (bad)
+			pr_err("octeon-des3: mismatch vs des3_ede-generic (round %d)\n",
+			       round);
+	}
+	memzero_explicit(&ctx, sizeof(ctx));
+	memzero_explicit(key, sizeof(key));
+	kfree(src);
+	crypto_free_cipher(gen);
+	return bad ? -EIO : 0;
+}
+
+static int __init octeon_des3_mod_init(void)
+{
+	int err;
+
+	if (!octeon_has_crypto())
+		return -ENOTSUPP;
+	err = octeon_des3_check();
+	if (err)
+		return err;
+	pr_info("octeon-des3: self-test against des3_ede-generic passed\n");
+
+	err = crypto_register_alg(&octeon_des3_cipher_alg);
+	if (err)
+		return err;
+	err = crypto_register_skciphers(octeon_des3_sk_algs,
+					ARRAY_SIZE(octeon_des3_sk_algs));
+	if (err)
+		crypto_unregister_alg(&octeon_des3_cipher_alg);
+	return err;
+}
+
+static void __exit octeon_des3_mod_exit(void)
+{
+	crypto_unregister_skciphers(octeon_des3_sk_algs,
+				    ARRAY_SIZE(octeon_des3_sk_algs));
+	crypto_unregister_alg(&octeon_des3_cipher_alg);
+}
+
+module_init(octeon_des3_mod_init);
+module_exit(octeon_des3_mod_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Triple DES, ECB and CBC using the OCTEON crypto coprocessor");
+MODULE_IMPORT_NS(CRYPTO_INTERNAL);
+MODULE_ALIAS_CRYPTO("des3_ede");
+MODULE_ALIAS_CRYPTO("des3_ede-octeon");
+MODULE_ALIAS_CRYPTO("ecb(des3_ede)");
+MODULE_ALIAS_CRYPTO("cbc(des3_ede)");
diff -Nurp a/arch/mips/cavium-octeon/crypto/octeon-gcm.c b/arch/mips/cavium-octeon/crypto/octeon-gcm.c
--- a/arch/mips/cavium-octeon/crypto/octeon-gcm.c	1970-01-01 10:00:00.000000000 +1000
+++ b/arch/mips/cavium-octeon/crypto/octeon-gcm.c	2026-11-12 10:31:06.264522752 +1100
@@ -0,0 +1,597 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AES-GCM as one pass on the OCTEON crypto coprocessor (COP2).
+ *
+ * The generic gcm template runs ctr(aes) and ghash as two separate passes
+ * over the scatterlists. Here every 16-byte block is encrypted by the AES unit
+ * and hashed by the Galois-field multiplier in the same COP2 session, with
+ * the AES operation for the next block started before the current block is
+ * hashed, so the two units work in parallel.
+ *
+ * Provides "gcm(aes)" (12-byte IV) and "rfc4106(gcm(aes))" (IPsec ESP).
+ *
+ * COP2 register selectors as used by the Cavium OCTEON SDK (cvmx-asm.h):
+ *   AES: 0x0104-0x0107 key, 0x0110 key length code, 0x010a/0x310b ECB
+ *        encrypt (writing 0x310b starts it), 0x0100-0x0101 result
+ *   GFM: 0x0258-0x0259 H, 0x025a-0x025b Y, 0x025c XOR into Y (high),
+ *        0x425d XOR into Y (low) then Y = Y * H, 0x025e polynomial (0xe100)
+ *
+ * The module checks itself at load against a GCM specification test vector
+ * and against the generic gcm_base(ctr(aes-generic),ghash-generic) with random
+ * data, and refuses to register on any mismatch.
+ */
+
+#include <crypto/aes.h>
+#include <crypto/algapi.h>
+#include <crypto/gcm.h>
+#include <crypto/internal/aead.h>
+#include <crypto/internal/skcipher.h>
+#include <crypto/scatterwalk.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/random.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <asm/octeon/octeon.h>
+
+#include "octeon-crypto.h"
+
+#define OCT_MT(val, sel) \
+	__asm__ __volatile__("dmtc2 %[rt]," #sel : : [rt] "d" ((u64)(val)))
+#define OCT_MF(sel) ({ u64 __v; \
+	__asm__ __volatile__("dmfc2 %[rt]," #sel : [rt] "=d" (__v)); __v; })
+
+#define GCM_PRIORITY	(OCTEON_CR_OPCODE_PRIORITY + 100)
+
+struct octeon_gcm_ctx {
+	u64 key[4];
+	u64 keylen_code;
+	u64 h[2];
+	u8 salt[4];		/* rfc4106 only */
+};
+
+/* Per-request state carried across COP2 sessions. */
+struct octeon_gcm_state {
+	u64 y[2];		/* running GHASH */
+	u64 ej0[2];		/* E(K, J0), XORed into the tag */
+	u64 c0;			/* counter block, high 64 bits */
+	u32 c1hi;		/* counter block, bits 32..63 */
+	u32 ctr;		/* counter block, low 32 bits (inc32) */
+};
+
+/* ---- COP2 helpers: call only between octeon_crypto_enable()/disable() ---- */
+
+static inline void gcm_load(const struct octeon_gcm_ctx *ctx, const u64 *y)
+{
+	OCT_MT(ctx->key[0], 0x0104);
+	OCT_MT(ctx->key[1], 0x0105);
+	OCT_MT(ctx->key[2], 0x0106);
+	OCT_MT(ctx->key[3], 0x0107);
+	OCT_MT(ctx->keylen_code, 0x0110);
+	OCT_MT(0xe100, 0x025e);
+	OCT_MT(ctx->h[0], 0x0258);
+	OCT_MT(ctx->h[1], 0x0259);
+	OCT_MT(y[0], 0x025a);
+	OCT_MT(y[1], 0x025b);
+}
+
+static inline void gcm_save(u64 *y)
+{
+	y[0] = OCT_MF(0x025a);
+	y[1] = OCT_MF(0x025b);
+}
+
+static inline void gcm_ghash(u64 a, u64 b)
+{
+	OCT_MT(a, 0x025c);
+	OCT_MT(b, 0x425d);
+}
+
+static inline void gcm_aes_start(u64 a, u64 b)
+{
+	OCT_MT(a, 0x010a);
+	OCT_MT(b, 0x310b);
+}
+
+/* GHASH over len bytes, zero-padding a final partial block. */
+static void gcm_ghash_bytes(const u8 *p, unsigned int len)
+{
+	for (; len >= 16; p += 16, len -= 16)
+		gcm_ghash(get_unaligned_be64(p), get_unaligned_be64(p + 8));
+	if (len) {
+		u8 blk[16] = { 0 };
+
+		memcpy(blk, p, len);
+		gcm_ghash(get_unaligned_be64(blk), get_unaligned_be64(blk + 8));
+	}
+}
+
+/*
+ * CTR-encrypt/decrypt len bytes and hash the ciphertext. Only the last call of
+ * a request may pass a length that is not a multiple of 16. Software pipeline:
+ * the AES unit encrypts counter block i+1 while the GFM hashes block i.
+ */
+static void gcm_crypt_bytes(struct octeon_gcm_state *st, u8 *dst,
+			    const u8 *src, unsigned int len, bool enc)
+{
+	unsigned int nblocks = len / 16, tail = len % 16;
+	u64 cnt = (u64)st->c1hi << 32;
+	u32 ctr = st->ctr;
+	u64 k0, k1;
+
+	if (!len)
+		return;
+	gcm_aes_start(st->c0, cnt | ctr++);
+	while (nblocks--) {
+		u64 s0 = get_unaligned_be64(src), s1 = get_unaligned_be64(src + 8);
+		u64 d0, d1;
+
+		k0 = OCT_MF(0x0100);
+		k1 = OCT_MF(0x0101);
+		/* start the next keystream block (harmless if unused) */
+		gcm_aes_start(st->c0, cnt | ctr);
+		if (nblocks || tail)
+			ctr++;
+		d0 = s0 ^ k0;
+		d1 = s1 ^ k1;
+		put_unaligned_be64(d0, dst);
+		put_unaligned_be64(d1, dst + 8);
+		if (enc)
+			gcm_ghash(d0, d1);
+		else
+			gcm_ghash(s0, s1);
+		src += 16;
+		dst += 16;
+	}
+	/* the keystream for the next block is in flight: collect it */
+	k0 = OCT_MF(0x0100);
+	k1 = OCT_MF(0x0101);
+	if (tail) {
+		u8 in[16] = { 0 }, ks[16], out[16] = { 0 };
+
+		memcpy(in, src, tail);
+		put_unaligned_be64(k0, ks);
+		put_unaligned_be64(k1, ks + 8);
+		crypto_xor_cpy(out, in, ks, tail);
+		memcpy(dst, out, tail);
+		/* GHASH input is the zero-padded ciphertext */
+		gcm_ghash_bytes(enc ? out : in, 16);
+		memzero_explicit(ks, sizeof(ks));
+		memzero_explicit(in, sizeof(in));
+		memzero_explicit(out, sizeof(out));
+	}
+	st->ctr = ctr;
+}
+
+/* ---- key setup ---- */
+
+static int octeon_gcm_aes_setkey(struct octeon_gcm_ctx *ctx, const u8 *key,
+				 unsigned int keylen)
+{
+	struct octeon_cop2_state cop2;
+	u8 buf[AES_MAX_KEY_SIZE] = { 0 };
+	unsigned long flags;
+	int i, err;
+
+	err = aes_check_keylen(keylen);
+	if (err)
+		return err;
+	memcpy(buf, key, keylen);
+	for (i = 0; i < 4; i++)
+		ctx->key[i] = get_unaligned_be64(buf + 8 * i);
+	ctx->keylen_code = keylen * 8 / 64 - 1;
+	memzero_explicit(buf, sizeof(buf));
+
+	/* H = E(K, 0^128) */
+	flags = octeon_crypto_enable(&cop2);
+	OCT_MT(ctx->key[0], 0x0104);
+	OCT_MT(ctx->key[1], 0x0105);
+	OCT_MT(ctx->key[2], 0x0106);
+	OCT_MT(ctx->key[3], 0x0107);
+	OCT_MT(ctx->keylen_code, 0x0110);
+	gcm_aes_start(0, 0);
+	ctx->h[0] = OCT_MF(0x0100);
+	ctx->h[1] = OCT_MF(0x0101);
+	octeon_crypto_disable(&cop2, flags);
+	return 0;
+}
+
+/* ---- core on linear buffers (also used by the load-time self-check) ---- */
+
+static void gcm_begin(const struct octeon_gcm_ctx *ctx,
+		      struct octeon_gcm_state *st, const u8 *iv12)
+{
+	struct octeon_cop2_state cop2;
+	unsigned long flags;
+
+	st->c0 = get_unaligned_be64(iv12);
+	st->c1hi = get_unaligned_be32(iv12 + 8);
+	st->ctr = 2;
+	st->y[0] = st->y[1] = 0;
+	flags = octeon_crypto_enable(&cop2);
+	gcm_load(ctx, st->y);
+	gcm_aes_start(st->c0, (u64)st->c1hi << 32 | 1);
+	st->ej0[0] = OCT_MF(0x0100);
+	st->ej0[1] = OCT_MF(0x0101);
+	octeon_crypto_disable(&cop2, flags);
+}
+
+static void gcm_finish(const struct octeon_gcm_ctx *ctx,
+		       struct octeon_gcm_state *st, u64 alen, u64 clen,
+		       u8 *tag)
+{
+	struct octeon_cop2_state cop2;
+	unsigned long flags;
+
+	flags = octeon_crypto_enable(&cop2);
+	gcm_load(ctx, st->y);
+	gcm_ghash(alen * 8, clen * 8);
+	gcm_save(st->y);
+	octeon_crypto_disable(&cop2, flags);
+	put_unaligned_be64(st->y[0] ^ st->ej0[0], tag);
+	put_unaligned_be64(st->y[1] ^ st->ej0[1], tag + 8);
+}
+
+static void gcm_linear(const struct octeon_gcm_ctx *ctx, const u8 *iv12,
+		       const u8 *aad, unsigned int alen, u8 *dst,
+		       const u8 *src, unsigned int len, bool enc, u8 *tag)
+{
+	struct octeon_gcm_state st;
+	struct octeon_cop2_state cop2;
+	unsigned long flags;
+
+	gcm_begin(ctx, &st, iv12);
+	flags = octeon_crypto_enable(&cop2);
+	gcm_load(ctx, st.y);
+	gcm_ghash_bytes(aad, alen);
+	gcm_crypt_bytes(&st, dst, src, len, enc);
+	gcm_save(st.y);
+	octeon_crypto_disable(&cop2, flags);
+	gcm_finish(ctx, &st, alen, len, tag);
+	memzero_explicit(&st, sizeof(st));
+}
+
+/* ---- AEAD request path ---- */
+
+#define AAD_CHUNK	256
+
+static void gcm_hash_aad(const struct octeon_gcm_ctx *ctx,
+			 struct octeon_gcm_state *st, struct scatterlist *sg,
+			 unsigned int alen)
+{
+	struct octeon_cop2_state cop2;
+	u8 buf[AAD_CHUNK];
+	unsigned long flags;
+	unsigned int off = 0;
+
+	while (off < alen) {
+		unsigned int n = min_t(unsigned int, alen - off, AAD_CHUNK);
+
+		scatterwalk_map_and_copy(buf, sg, off, n, 0);
+		flags = octeon_crypto_enable(&cop2);
+		gcm_load(ctx, st->y);
+		gcm_ghash_bytes(buf, n);	/* only the last chunk can be partial */
+		gcm_save(st->y);
+		octeon_crypto_disable(&cop2, flags);
+		off += n;
+	}
+}
+
+static int octeon_gcm_crypt(struct aead_request *req, const u8 *iv12,
+			    unsigned int alen, bool enc)
+{
+	struct crypto_aead *tfm = crypto_aead_reqtfm(req);
+	const struct octeon_gcm_ctx *ctx = crypto_aead_ctx(tfm);
+	unsigned int authsize = crypto_aead_authsize(tfm);
+	unsigned int len = req->cryptlen - (enc ? 0 : authsize);
+	struct octeon_cop2_state cop2;
+	struct octeon_gcm_state st;
+	struct skcipher_walk walk;
+	u8 tag[16], itag[16];
+	unsigned long flags;
+	unsigned int nbytes;
+	int err;
+
+	gcm_begin(ctx, &st, iv12);
+	if (alen)
+		gcm_hash_aad(ctx, &st, req->src, alen);
+
+	err = enc ? skcipher_walk_aead_encrypt(&walk, req, false) :
+		    skcipher_walk_aead_decrypt(&walk, req, false);
+	while ((nbytes = walk.nbytes)) {
+		unsigned int n = nbytes;
+
+		if (nbytes < walk.total)
+			n = round_down(nbytes, 16);
+		flags = octeon_crypto_enable(&cop2);
+		gcm_load(ctx, st.y);
+		gcm_crypt_bytes(&st, walk.dst.virt.addr, walk.src.virt.addr,
+				n, enc);
+		gcm_save(st.y);
+		octeon_crypto_disable(&cop2, flags);
+		err = skcipher_walk_done(&walk, nbytes - n);
+	}
+	if (err)
+		goto out;
+
+	gcm_finish(ctx, &st, alen, len, tag);
+	if (enc) {
+		scatterwalk_map_and_copy(tag, req->dst, req->assoclen + len,
+					 authsize, 1);
+	} else {
+		scatterwalk_map_and_copy(itag, req->src, req->assoclen + len,
+					 authsize, 0);
+		if (crypto_memneq(tag, itag, authsize))
+			err = -EBADMSG;
+	}
+out:
+	memzero_explicit(&st, sizeof(st));
+	memzero_explicit(tag, sizeof(tag));
+	return err;
+}
+
+static int octeon_gcm_setkey(struct crypto_aead *tfm, const u8 *key,
+			     unsigned int keylen)
+{
+	return octeon_gcm_aes_setkey(crypto_aead_ctx(tfm), key, keylen);
+}
+
+static int octeon_gcm_setauthsize(struct crypto_aead *tfm,
+				  unsigned int authsize)
+{
+	return crypto_gcm_check_authsize(authsize);
+}
+
+static int octeon_gcm_encrypt(struct aead_request *req)
+{
+	return octeon_gcm_crypt(req, req->iv, req->assoclen, true);
+}
+
+static int octeon_gcm_decrypt(struct aead_request *req)
+{
+	return octeon_gcm_crypt(req, req->iv, req->assoclen, false);
+}
+
+/* rfc4106: key = AES key || 4-byte salt; IV = salt || 8-byte req->iv;
+ * req->assoclen counts the 8-byte IV copy that ends the associated data. */
+static int octeon_rfc4106_setkey(struct crypto_aead *tfm, const u8 *key,
+				 unsigned int keylen)
+{
+	struct octeon_gcm_ctx *ctx = crypto_aead_ctx(tfm);
+
+	if (keylen < 4)
+		return -EINVAL;
+	keylen -= 4;
+	memcpy(ctx->salt, key + keylen, 4);
+	return octeon_gcm_aes_setkey(ctx, key, keylen);
+}
+
+static int octeon_rfc4106_setauthsize(struct crypto_aead *tfm,
+				      unsigned int authsize)
+{
+	return crypto_rfc4106_check_authsize(authsize);
+}
+
+static int octeon_rfc4106_crypt(struct aead_request *req, bool enc)
+{
+	const struct octeon_gcm_ctx *ctx =
+		crypto_aead_ctx(crypto_aead_reqtfm(req));
+	u8 iv[GCM_AES_IV_SIZE];
+	int err;
+
+	err = crypto_ipsec_check_assoclen(req->assoclen);
+	if (err)
+		return err;
+	memcpy(iv, ctx->salt, 4);
+	memcpy(iv + 4, req->iv, 8);
+	return octeon_gcm_crypt(req, iv, req->assoclen - 8, enc);
+}
+
+static int octeon_rfc4106_encrypt(struct aead_request *req)
+{
+	return octeon_rfc4106_crypt(req, true);
+}
+
+static int octeon_rfc4106_decrypt(struct aead_request *req)
+{
+	return octeon_rfc4106_crypt(req, false);
+}
