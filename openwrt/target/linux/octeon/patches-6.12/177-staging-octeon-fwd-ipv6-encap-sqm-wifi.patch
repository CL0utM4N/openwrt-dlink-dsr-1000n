From: Lachlan Green <69705346+CL0utM4N@users.noreply.github.com>
Subject: [PATCH] staging: octeon: octeon-fwd: IPv6, VLAN/PPPoE, shaper-aware, skb transmit

- IPv6 (TCP/UDP, no extension headers) next to IPv4.
- VLAN (802.1Q/802.1ad), PPPoE and PPPoE over VLAN: headers popped on
  receive and pushed on transmit; the output VLAN/PPP device is followed
  down to its port with dev_fill_forward_path(), as the flowtable does.
  Counters of the VLAN/PPP devices are kept.
- Never bypass shaping: packets on a port with tc ingress (SQM download
  side) take the normal path; a shaping qdisc on any output device sends
  the packet through dev_queue_xmit() instead of straight to the PKO.
- Outputs that are not Octeon ports (Wi-Fi, other drivers) get the
  rewritten packet as an skb through dev_queue_xmit() (new hook result
  CVM_OCT_RX_STOLEN), saving the second lookup in the flowtable.
- Driver fast path: ports with tc ingress keep the normal path, so
  nf_hook_ingress() no longer runs ahead of SQM's ingress shaping.
diff -Nurp a/drivers/staging/octeon/ethernet-rx.c b/drivers/staging/octeon/ethernet-rx.c
--- a/drivers/staging/octeon/ethernet-rx.c	2026-11-12 12:57:06.245311543 +1100
+++ b/drivers/staging/octeon/ethernet-rx.c	2026-11-12 12:57:28.517225847 +1100
@@ -202,6 +202,16 @@ module_param(fastpath_misses, ulong, 044
 static unsigned long fastpath_seen;
 module_param(fastpath_seen, ulong, 0444);
 
+/* tc ingress (ingress/clsact qdisc, e.g. SQM's download shaping) on @dev */
+static inline bool cvm_oct_tc_ingress(const struct net_device *dev)
+{
+#ifdef CONFIG_NET_XGRESS
+	return rcu_access_pointer(dev->tcx_ingress);
+#else
+	return false;
+#endif
+}
+
 /* Returns true if the skb was consumed (forwarded, delivered or freed). */
 static bool cvm_oct_fastpath_rx(struct sk_buff *skb)
 {
@@ -209,6 +219,13 @@ static bool cvm_oct_fastpath_rx(struct s
 	struct sk_buff *nskb;
 	int ret;
 
+	/*
+	 * nf_hook_ingress() below runs before tc ingress would: a port with
+	 * ingress shaping keeps the normal path so the shaper sees everything.
+	 */
+	if (cvm_oct_tc_ingress(dev))
+		return false;
+
 	if (netdev_uses_dsa(dev)) {
 		struct dsa_port *cpu_dp = dev->dsa_ptr;
 		__be16 etype;
@@ -268,6 +285,9 @@ static bool cvm_oct_fastpath_rx(struct s
 		if (!rcu_access_pointer(user->nf_hooks_ingress))
 			target = upper;
 	}
+	if (cvm_oct_tc_ingress(user) ||
+	    (target != user && cvm_oct_tc_ingress(target)))
+		goto slow;
 	if (!ether_addr_equal(eth_hdr(skb)->h_dest, upper->dev_addr))
 		goto slow;
 
@@ -477,6 +497,8 @@ static int cvm_oct_poll(struct oct_rx_gr
 						cvm_oct_free_work(work);
 						continue;
 					}
+					if (r == CVM_OCT_RX_STOLEN)
+						goto rx_done;	/* skb owned by the hook */
 				}
 				skb->protocol = eth_type_trans(skb, dev);
 				skb->dev = dev;
@@ -516,6 +538,7 @@ static int cvm_oct_poll(struct oct_rx_gr
 					   port);
 			dev_kfree_skb_irq(skb);
 		}
+rx_done:
 		/*
 		 * Check to see if the skbuff and work share the same
 		 * packet buffer.
