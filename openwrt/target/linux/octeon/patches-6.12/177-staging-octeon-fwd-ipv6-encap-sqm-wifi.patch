-/* Resolve how to transmit on @out; @rx is the receiving Octeon port. */
+/*
+ * Resolve how to transmit on @out (as the flowtable names it); @rx is the
+ * receiving Octeon port. VLAN and PPP(oE) devices are followed down to the
+ * port they run on with dev_fill_forward_path(), the same walk the
+ * flowtable did when it offloaded the flow, and their headers recorded.
+ */
 static const struct fwd_out_ent *fwd_out_dev(struct net_device *rx,
 					     struct net_device *out)
 {
 	/* power-of-two mask: a signed % would be a hardware divide per packet */
 	struct fwd_out_ent *e =
 		&fwd_out_cache[(unsigned int)out->ifindex & (FWD_OUT_SLOTS - 1)];
-	struct net_device *txdev;
+	struct fwd_out_ent t = {};
+	struct net_device *real = out;
 	struct dsa_port *odp;
-	u8 tagged = 0, port = 0;
+	int i;
 
 	if (likely(READ_ONCE(e->dev) == out && e->ifindex == out->ifindex))
 		return e;
-	if (dsa_user_dev_check(out)) {
-		odp = dsa_port_from_netdev(out);
+
+	if (is_vlan_dev(out) || out->type == ARPHRD_PPP) {
+		static const u8 zero_mac[ETH_ALEN];
+		struct net_device_path_stack stack;
+		struct fwd_encap path_enc[FWD_ENCAP_MAX];
+		int n = 0;
+
+		real = NULL;
+		if (dev_fill_forward_path(out, zero_mac, &stack) < 0)
+			goto skb_path;
+		for (i = 0; i < stack.num_paths && !real; i++) {
+			const struct net_device_path *p = &stack.path[i];
+
+			switch (p->type) {
+			case DEV_PATH_VLAN:
+			case DEV_PATH_PPPOE:
+				if (n >= FWD_ENCAP_MAX)
+					goto skb_path;
+				path_enc[n].proto = p->encap.proto;
+				path_enc[n].id = p->encap.id;
+				path_enc[n].dev = (struct net_device *)p->dev;
+				if (p->type == DEV_PATH_VLAN)
+					path_enc[n].id |= vlan_dev_get_egress_qos_mask(
+						(struct net_device *)p->dev, 0);
+				n++;
+				break;
+			case DEV_PATH_ETHERNET:
+			case DEV_PATH_DSA:
+				real = (struct net_device *)p->dev;
+				break;
+			default:	/* bridges, MTK WDMA, ... */
+				goto skb_path;
+			}
+		}
+		if (!real)
+			goto skb_path;
+		/* PPPoE must be innermost on the wire */
+		for (i = 0; i < n; i++)
+			if (path_enc[i].proto == htons(ETH_P_PPP_SES) && i != 0)
+				goto skb_path;
+		/* path order is upper to lower = innermost first; store wire order */
+		for (i = 0; i < n; i++)
+			t.encap[i] = path_enc[n - 1 - i];
+		t.n_encap = n;
+	}
+
+	if (dsa_user_dev_check(real)) {
+		odp = dsa_port_from_netdev(real);
 		if (IS_ERR(odp) || odp->ds->index != 0 || odp->index > 7)
-			return NULL;
-		txdev = odp->cpu_dp->conduit;
-		tagged = 1;
-		port = odp->index;
+			goto skb_path;
+		t.txdev = odp->cpu_dp->conduit;
+		t.tagged = 1;
+		t.port = odp->index;
 	} else {
-		txdev = out;
+		t.txdev = real;
 	}
 	/* both ends must be Octeon ports driven by octeon-ethernet */
-	if (txdev->netdev_ops != rx->netdev_ops ||
-	    !!netdev_uses_dsa(txdev) != !!tagged)
-		return NULL;
+	if (t.txdev->netdev_ops != rx->netdev_ops ||
+	    !!netdev_uses_dsa(t.txdev) != !!t.tagged)
+		goto skb_path;
+	t.real = real;
