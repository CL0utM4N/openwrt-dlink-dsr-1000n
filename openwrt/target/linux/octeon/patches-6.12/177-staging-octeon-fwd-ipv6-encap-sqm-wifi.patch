+/* Ingress shaping (tc ingress / clsact, e.g. SQM via ifb) on this device. */
+static inline bool fwd_rx_tc(const struct net_device *dev)
+{
+#ifdef CONFIG_NET_XGRESS
+	return rcu_access_pointer(dev->tcx_ingress);
+#else
+	return false;
+#endif
+}
+
+/*
+ * A queueing discipline that changes what goes out (shaper, scheduler) on
+ * this device's transmit queue. noqueue, pfifo_fast and the default qdisc
+ * (fq_codel) only queue under backpressure and are bypassed like the PKO
+ * path always did.
+ */
+static inline bool fwd_tx_shaped(const struct net_device *dev)
+{
+	const struct Qdisc *q = rcu_dereference(netdev_get_tx_queue(dev, 0)->qdisc);
+
+	return q && q->enqueue && q->ops != default_qdisc_ops &&
+	       q->ops != &pfifo_fast_ops;
+}
