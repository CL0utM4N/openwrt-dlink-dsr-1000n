+static void fwd_upper_stats(struct net_device *d, unsigned int len, bool rx)
+{
+	if (is_vlan_dev(d)) {
+		struct vlan_pcpu_stats *s =
+			this_cpu_ptr(vlan_dev_priv(d)->vlan_pcpu_stats);
+
+		u64_stats_update_begin(&s->syncp);
+		if (rx) {
+			u64_stats_inc(&s->rx_packets);
+			u64_stats_add(&s->rx_bytes, len);
+		} else {
+			u64_stats_inc(&s->tx_packets);
+			u64_stats_add(&s->tx_bytes, len);
+		}
+		u64_stats_update_end(&s->syncp);
+	} else if (d->pcpu_stat_type == NETDEV_PCPU_STAT_TSTATS) {
+		if (rx)
+			dev_sw_netstats_rx_add(d, len);
+		else
+			dev_sw_netstats_tx_add(d, 1, len);
+	}
+}
