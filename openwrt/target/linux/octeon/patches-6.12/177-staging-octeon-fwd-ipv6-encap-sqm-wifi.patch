-	e->ifindex = out->ifindex;
-	e->txdev = txdev;
-	e->tagged = tagged;
-	e->port = port;
+	t.dev = NULL;
+	*e = t;
 	WRITE_ONCE(e->dev, out);
 	spin_unlock(&fwd_cache_lock);
 	return e;
 }
 
+static struct net_device *fwd_dev_by_index(struct net *net, int ifindex)
+{
+	const struct fwd_out_ent *hint =
+		&fwd_out_cache[(unsigned int)ifindex & (FWD_OUT_SLOTS - 1)];
+	struct net_device *d = READ_ONCE(hint->dev);
+
+	if (d && hint->ifindex == ifindex)
+		return d;
+	return dev_get_by_index_rcu(net, ifindex);
+}
