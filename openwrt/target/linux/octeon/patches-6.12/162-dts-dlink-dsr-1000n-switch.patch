Subject: MIPS: dts: dsr-1000n: describe the BCM53115 switch and port names

--- a/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts	2026-11-10 19:19:34.925630423 +1100
+++ b/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts	2026-11-10 19:19:34.939599924 +1100
@@ -46,3 +46,54 @@
 		};
 	};
 };
+
+&smi0 {
+	switch@1e {
+		compatible = "brcm,bcm53115";
+		reg = <30>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				label = "lan1";
+			};
+			port@1 {
+				reg = <1>;
+				label = "lan2";
+			};
+			port@2 {
+				reg = <2>;
+				label = "lan3";
+			};
+			port@3 {
+				reg = <3>;
+				label = "lan4";
+			};
+			port@4 {
+				reg = <4>;
+				label = "wan";
+			};
+			port@8 {
+				reg = <8>;
+				ethernet = <&{/soc@0/pip@11800a0000000/interface@0/ethernet@0}>;
+				phy-mode = "rgmii-id";
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+&pip {
+	interface@0 {
+		ethernet@2 {
+			label = "wan2";
+		};
+	};
+};
