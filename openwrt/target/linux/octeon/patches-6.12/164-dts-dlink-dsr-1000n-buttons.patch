Subject: MIPS: dts: dsr-1000n: add reset and WPS buttons

--- a/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts	2026-11-10 21:59:12.692244418 +1100
+++ b/arch/mips/boot/dts/cavium-octeon/dlink_dsr-1000n.dts	2026-11-10 21:59:12.708295668 +1100
@@ -7,6 +7,7 @@
 
 /include/ "dlink_dsr-500n-1000n.dtsi"
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
 
 / {
 	model = "dlink,dsr-1000n";
@@ -17,6 +18,23 @@
 		};
 	};
 
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <20>;
+
+		key-reset {
+			label = "reset";
+			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		key-wps {
+			label = "wps";
+			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+		};
+	};
+
 	leds {
 		compatible = "gpio-leds";
 
